#Использовать opentelemetry
#Использовать decorator

// Трассировщик OTel для спанов методов репозитория (ленивое получение из Табакерки).
Перем Трассировщик;
// Метр OTel для гистограммы вызовов репозитория (ленивое получение из Табакерки).
Перем Метр;
// Табакерка трассировщика: SDK не инициализируется, если ни один бин не обернут.
Перем ТабакеркаТрассировщика;
// Табакерка метра.
Перем ТабакеркаМетра;
// Рефлектор для чтения методов объекта и установки полей в декоратор.
Перем ЛокальныйРефлектор;
// Признак включения инструментирования слоя репозиториев.
Перем Включен;
// Соответствие - Методы хранилища, которые не ходят в БД и не оборачиваются (в нижнем регистре).
Перем ИсключаемыеМетоды;

// Оборачивает хранилище сущностей autumn-data в декоратор со спанами и гистограммой вызовов.
// Бины, не являющиеся хранилищами, возвращает без изменений.
//
// Параметры:
//   Желудь             - Произвольный      - Экземпляр бина
//   ОпределениеЖелудя  - ОпределениеЖелудя - Метаданные бина (имя, прозвища, завязь)
//
// Возвращаемое значение:
//   Произвольный - Оригинальный бин или декоратор с перехватчиками
//
Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт

	Если НЕ Включен ИЛИ НЕ ЭтоХранилищеСущностей(ОпределениеЖелудя) Тогда
		Возврат Желудь;
	КонецЕсли;

	// Методы берутся с самого объекта, а не из определения желудя: у пользовательского
	// хранилища в определении нет унаследованных от ХранилищеСущностей методов, а у
	// хранилища из lambda-завязи autumn-data - нет ни одного.
	ИменаМетодов = ИменаОборачиваемыхМетодов(Желудь);
	Если ИменаМетодов.Количество() = 0 Тогда
		Возврат Желудь;
	КонецЕсли;

	Если Трассировщик = Неопределено Тогда
		Трассировщик = ТабакеркаТрассировщика.Достать();
		Метр = ТабакеркаМетра.Достать();
	КонецЕсли;

	ИмяБина = ОпределениеЖелудя.Имя();

	Построитель = Новый ПостроительДекоратора(Желудь)
		.Импорт(Новый Импорт("opentelemetry"))
		.Поле(Новый Поле("Декоратор_Трассировщик"))
		.Поле(Новый Поле("Декоратор_Метр"));

	Для Каждого ИмяМетода Из ИменаМетодов Цикл
		ДобавитьПерехватчики(Построитель, ИмяБина, ИмяМетода);
	КонецЦикла;

	Декоратор = Построитель.Построить();
	ЛокальныйРефлектор.УстановитьСвойство(Декоратор, "Декоратор_Трассировщик", Трассировщик);
	ЛокальныйРефлектор.УстановитьСвойство(Декоратор, "Декоратор_Метр", Метр);

	Возврат Декоратор;

КонецФункции

// Хранилище - бин с прозвищем ХранилищеСущностей (lambda-завязь autumn-data) или с аннотацией
// &ХранилищеСущностей на конструкторе (пользовательское хранилище).
//
Функция ЭтоХранилищеСущностей(ОпределениеЖелудя)

	Для Каждого Прозвище Из ОпределениеЖелудя.Прозвища() Цикл
		Если НРег(Прозвище) = "хранилищесущностей" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Конструктор = ОпределениеЖелудя.Завязь().ДанныеМетода();
	Возврат РаботаСАннотациями.НайтиАннотацию(Конструктор.Аннотации, "ХранилищеСущностей") <> Неопределено;

КонецФункции

Функция ИменаОборачиваемыхМетодов(Желудь)

	Результат = Новый Массив;

	Для Каждого Метод Из ЛокальныйРефлектор.ПолучитьТаблицуМетодов(Желудь) Цикл
		Если НЕ Метод.Экспорт Тогда
			Продолжить;
		КонецЕсли;
		ИмяВНижнемРегистре = НРег(Метод.Имя);
		Если ИсключаемыеМетоды.Получить(ИмяВНижнемРегистре) <> Неопределено ИЛИ Лев(ИмяВНижнемРегистре, 10) = "декоратор_" Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Метод.Имя);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьПерехватчики(Построитель, Знач ИмяБина, Знач ИмяМетода)

	ТелоПеред = "Декоратор_ЛокальныйСпан = Декоратор_Трассировщик.НачатьСпан(""" + ИмяБина + "." + ИмяМетода + """);
		|Декоратор_ЛокальныйСпан.УстановитьАтрибут(""code.function.name"", """ + ИмяМетода + """);
		|Декоратор_ЛокальныйСпан.УстановитьАтрибут(""code.namespace"", """ + ИмяБина + """);
		|Декоратор_ОбластьСпана = Декоратор_ЛокальныйСпан.СделатьТекущим();
		|Декоратор_ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();";

	ТелоПосле = "Декоратор_ОбластьСпана.Закрыть();
		|Декоратор_ЛокальныйСпан.Завершить();
		|Декоратор_Атрибуты = Новый ОтелАтрибуты();
		|Декоратор_Атрибуты.Установить(""entity.repository"", """ + ИмяБина + """);
		|Декоратор_Атрибуты.Установить(""code.function.name"", """ + ИмяМетода + """);
		|Декоратор_Атрибуты.Установить(""entity.repository.state"", ""success"");
		|" + ЗаписьГистограммы();

	ТелоИсключения = "Декоратор_ТипОшибки = ИнформацияОбОшибке().ИмяМодуля;
		|Если ПустаяСтрока(Декоратор_ТипОшибки) Тогда
		|	Декоратор_ТипОшибки = ""RuntimeError"";
		|КонецЕсли;
		|Декоратор_ЛокальныйСпан.ЗаписатьИсключение(ИнформацияОбОшибке());
		|Декоратор_ЛокальныйСпан.УстановитьСтатус(ОтелКодСтатуса.Ошибка(), ОписаниеОшибки());
		|Декоратор_ЛокальныйСпан.УстановитьАтрибут(""error.type"", Декоратор_ТипОшибки);
		|Декоратор_ОбластьСпана.Закрыть();
		|Декоратор_ЛокальныйСпан.Завершить();
		|Декоратор_Атрибуты = Новый ОтелАтрибуты();
		|Декоратор_Атрибуты.Установить(""entity.repository"", """ + ИмяБина + """);
		|Декоратор_Атрибуты.Установить(""code.function.name"", """ + ИмяМетода + """);
		|Декоратор_Атрибуты.Установить(""entity.repository.state"", ""error"");
		|Декоратор_Атрибуты.Установить(""error.type"", Декоратор_ТипОшибки);
		|" + ЗаписьГистограммы();

	Построитель
		.Перехватчик(Новый Перехватчик(ИмяМетода).ТипПерехватчика(ТипыПерехватчиковМетода.Перед).Тело(ТелоПеред))
		.Перехватчик(Новый Перехватчик(ИмяМетода).ТипПерехватчика(ТипыПерехватчиковМетода.После).Тело(ТелоПосле))
		.Перехватчик(Новый Перехватчик(ИмяМетода).ТипПерехватчика(ТипыПерехватчиковМетода.ПослеВызоваИсключения).Тело(ТелоИсключения));

КонецПроцедуры

// Текст записи длительности вызова в гистограмму entity.repository.invocations, в секундах,
// с границами бакетов из семантических соглашений для клиентов баз данных.
//
Функция ЗаписьГистограммы()

	Возврат "Декоратор_Совет = Новый Структура(""ГраницыГистограммы"", ОтелСемантическиеСоглашения.ГраницыДлительностиОперацииБД());
		|Декоратор_Метр.СоздатьГистограмму(""entity.repository.invocations"", ""Длительность вызовов методов хранилищ сущностей"", ""s"", Декоратор_Совет)
		|	.Записать((ТекущаяУниверсальнаяДатаВМиллисекундах() - Декоратор_ВремяНачала) / 1000, Декоратор_Атрибуты);";

КонецФункции

// Напильник слоя репозиториев: оборачивает хранилища сущностей autumn-data в декоратор, который
// на каждый вызов метода создает спан INTERNAL "ИмяБина.ИмяМетода" с атрибутами code.* и пишет
// длительность в гистограмму entity.repository.invocations - аналог spring.data.repository.invocations.
// Операции entity и запросы к СУБД, которые выполняет метод, становятся дочерними спанами
// благодаря ОтелНаблюдательИсточникаДанных.
//
// Оборачиваются все экспортные методы фактического объекта, кроме тех, что не ходят в БД:
// ПолучитьОбъектМодели, ПолучитьПулСущностей, СоздатьЭлемент, Закрыть.
//
// Параметры:
//   ОтелТрассировщик - Табакерка - Табакерка для отложенного получения трассировщика OTel
//   ОтелМетр         - Табакерка - Табакерка для отложенного получения метра OTel
//   ОтелВключен      - Булево, Строка - Признак включения инструментирования (otel.enabled)
//   СлойВключен      - Булево, Строка - Признак включения слоя репозиториев (otel.entity.repository.enabled);
//                                       по умолчанию наследует otel.enabled
//
&Напильник
&Порядок(503)
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин("ОтелТрассировщик") ОтелТрассировщик,
		&Табакерка &Пластилин("ОтелМетр") ОтелМетр,
		&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = Ложь) ОтелВключен,
		&Деталька(Значение = "otel.entity.repository.enabled", ЗначениеПоУмолчанию = "") СлойВключен)

	ТабакеркаТрассировщика = ОтелТрассировщик;
	ТабакеркаМетра = ОтелМетр;
	Включен = ОтелДетальки.ЭтоВключено(ОтелВключен) И ОтелДетальки.ЭтоВключено(СлойВключен, Истина);
	ЛокальныйРефлектор = Новый Рефлектор();

	ИсключаемыеМетоды = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("присозданииобъекта,получитьобъектмодели,получитьпулсущностей,создатьэлемент,закрыть", ",") Цикл
		ИсключаемыеМетоды.Вставить(Имя, Истина);
	КонецЦикла;

КонецПроцедуры
