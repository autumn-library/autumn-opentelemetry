#Использовать opentelemetry-instrumentation-entity

// ОтелИнструментированиеХранилищаСущностей - Оборачивает хранилища сущностей (ленивое создание:
// SDK не инициализируется, если ни один бин не обернут).
Перем Инструментирование;
// Табакерка трассировщика.
Перем ТабакеркаТрассировщика;
// Табакерка метра.
Перем ТабакеркаМетра;
// Признак включения инструментирования слоя хранилищ.
Перем Включен;

// Оборачивает хранилища сущностей в инструментирующую обертку.
// Бины, не являющиеся хранилищами, возвращает без изменений.
//
// Параметры:
//   Желудь             - Произвольный      - Экземпляр бина
//   ОпределениеЖелудя  - ОпределениеЖелудя - Метаданные бина (имя, прозвища, завязь)
//
// Возвращаемое значение:
//   Произвольный - Оригинальный бин или обертка со спанами и метриками
//
Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт

	Если НЕ Включен ИЛИ НЕ ЭтоХранилищеСущностей(ОпределениеЖелудя) Тогда
		Возврат Желудь;
	КонецЕсли;

	Если Инструментирование = Неопределено Тогда
		Инструментирование = Новый ОтелИнструментированиеХранилищаСущностей(
			ТабакеркаТрассировщика.Достать(),
			ТабакеркаМетра.Достать()
		);
	КонецЕсли;

	Возврат Инструментирование.Обернуть(Желудь, ОпределениеЖелудя.Имя());

КонецФункции

Функция ЭтоХранилищеСущностей(ОпределениеЖелудя)

	Для Каждого Прозвище Из ОпределениеЖелудя.Прозвища() Цикл
		Если НРег(Прозвище) = "хранилищесущностей" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Напильник слоя хранилищ сущностей: находит бины с прозвищем ХранилищеСущностей и отдает их
// инструментированию из opentelemetry-instrumentation-entity, которое оборачивает вызовы методов
// спанами и гистограммой entity.repository.invocations.
//
// Параметры:
//   ОтелТрассировщик - Табакерка - Табакерка для отложенного получения трассировщика OTel
//   ОтелМетр         - Табакерка - Табакерка для отложенного получения метра OTel
//   ОтелВключен      - Булево, Строка - Признак включения инструментирования (otel.enabled)
//   СлойВключен      - Булево, Строка - Признак включения слоя хранилищ (otel.entity.repository.enabled);
//                                       по умолчанию наследует otel.enabled
//
&Напильник
&Порядок(503)
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин("ОтелТрассировщик") ОтелТрассировщик,
		&Табакерка &Пластилин("ОтелМетр") ОтелМетр,
		&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = Ложь) ОтелВключен,
		&Деталька(Значение = "otel.entity.repository.enabled", ЗначениеПоУмолчанию = "") СлойВключен)

	ТабакеркаТрассировщика = ОтелТрассировщик;
	ТабакеркаМетра = ОтелМетр;
	Включен = ОтелДетальки.ЭтоВключено(ОтелВключен) И ОтелДетальки.ЭтоВключено(СлойВключен, Истина);

КонецПроцедуры
