#Использовать opentelemetry
#Использовать annotations
#Использовать decorator

// Метр OTel для создания счетчиков вызовов методов (ленивое получение из Табакерки).
Перем Метр;
// Табакерка для отложенного получения метра (SDK не инициализируется если не нужен).
Перем ТабакеркаМетра;
// Рефлектор для установки полей в сгенерированный декоратор.
Перем ЛокальныйРефлектор;
// Признак включения инструментирования напильниками OTel.
Перем Включен;

// Оборачивает желудь в декоратор со счетчиком вызовов методов.
// Если инструментирование отключено или бин не имеет методов с аннотацией @Подсчитываемый,
// возвращает желудь без изменений.
//
// Параметры:
//   Желудь             - Произвольный      - Экземпляр бина
//   ОпределениеЖелудя  - ОпределениеЖелудя - Метаданные бина (имя, аннотации, методы)
//
// Возвращаемое значение:
//   Произвольный - Оригинальный бин или декоратор со счетчиком вызовов
//
Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт

	Если НЕ Включен Тогда
		Возврат Желудь;
	КонецЕсли;

	МетодыДляИнструментирования = ПолучитьМетодыДляИнструментирования(Желудь, ОпределениеЖелудя);

	Если МетодыДляИнструментирования.Количество() = 0 Тогда
		Возврат Желудь;
	КонецЕсли;

	Если Метр = Неопределено Тогда
		Метр = ТабакеркаМетра.Достать();
	КонецЕсли;

	Построитель = Новый ПостроительДекоратора(Желудь)
		.Импорт(Новый Импорт("opentelemetry"))
		.Поле(Новый Поле("Декоратор_МетрСчетчика"));

	Для Каждого ОписаниеМетода Из МетодыДляИнструментирования Цикл

		ИмяМетода = ОписаниеМетода.ИмяМетода;
		ИмяМетрики = ОписаниеМетода.ИмяМетрики;
		ИмяКласса = ОписаниеМетода.ИмяКласса;

		ТелоПеред = "Декоратор_ЛокальныеАтрибуты = Новый ОтелАтрибуты();
			|Декоратор_ЛокальныеАтрибуты.Установить(""code.function.name"", """ + ИмяМетода + """);
			|Декоратор_ЛокальныеАтрибуты.Установить(""code.namespace"", """ + ИмяКласса + """);";

		ТелоПосле = "Декоратор_ЛокальныеАтрибуты.Установить(""result"", ""success"");
			|Декоратор_МетрСчетчика.СоздатьСчетчик(""" + ИмяМетрики + """).Добавить(1, Декоратор_ЛокальныеАтрибуты);";

		ТелоИсключения = "Декоратор_ЛокальныеАтрибуты.Установить(""result"", ""failure"");
			|Декоратор_ЛокальныеАтрибуты.Установить(""exception"", ОписаниеОшибки());
			|Декоратор_МетрСчетчика.СоздатьСчетчик(""" + ИмяМетрики + """).Добавить(1, Декоратор_ЛокальныеАтрибуты);";

		ПерехватчикПеред = Новый Перехватчик(ИмяМетода)
			.ТипПерехватчика(ТипыПерехватчиковМетода.Перед)
			.Тело(ТелоПеред);
		ПерехватчикПосле = Новый Перехватчик(ИмяМетода)
			.ТипПерехватчика(ТипыПерехватчиковМетода.После)
			.Тело(ТелоПосле);
		ПерехватчикИсключения = Новый Перехватчик(ИмяМетода)
			.ТипПерехватчика(ТипыПерехватчиковМетода.ПослеВызоваИсключения)
			.Тело(ТелоИсключения);
		Построитель
			.Перехватчик(ПерехватчикПеред)
			.Перехватчик(ПерехватчикПосле)
			.Перехватчик(ПерехватчикИсключения);

	КонецЦикла;

	Декоратор = Построитель.Построить();
	ЛокальныйРефлектор.УстановитьСвойство(Декоратор, "Декоратор_МетрСчетчика", Метр);

	Возврат Декоратор;

КонецФункции

Функция ПолучитьМетодыДляИнструментирования(Желудь, ОпределениеЖелудя)

	ИмяАннотации = "Подсчитываемый";
	ПараметрЗначение = "Значение";

	Результат = Новый Массив();

	ИмяБина = ОпределениеЖелудя.Имя();
	Завязь = ОпределениеЖелудя.Завязь();

	АннотацияНаКлассе = РаботаСАннотациями.ПолучитьАннотацию(Завязь.ДанныеМетода(), ИмяАннотации);

	Если АннотацияНаКлассе <> Неопределено Тогда

		ПрефиксМетрики = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(АннотацияНаКлассе, ПараметрЗначение, "");
		Если ПрефиксМетрики = "" Тогда
			ПрефиксМетрики = ОтелУтилиты.Транслитерировать(ИмяБина);
		КонецЕсли;

		МетодыКласса = СобратьМетодыКлассаПодсчитываемый(Желудь, ОпределениеЖелудя, ПрефиксМетрики, ИмяБина);
		Для Каждого Описание Из МетодыКласса Цикл
			Результат.Добавить(Описание);
		КонецЦикла;

	Иначе

		МетодыСАннотацией = СобратьМетодыСАннотациейПодсчитываемый(ОпределениеЖелудя, ИмяБина);
		Для Каждого Описание Из МетодыСАннотацией Цикл
			Результат.Добавить(Описание);
		КонецЦикла;

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Аннотация на конструкторе покрывает все экспортные методы желудя, включая унаследованные
// от родителя: список методов берется с самого объекта, а не из определения желудя, где
// родительских методов нет. Определение нужно только ради аннотации на методе, задающей
// собственное имя метрики.
//
// Параметры:
//   Желудь            - Произвольный      - Экземпляр бина
//   ОпределениеЖелудя - ОпределениеЖелудя - Метаданные бина
//   ПрефиксМетрики    - Строка            - Имя, к которому приписывается имя метода
//   ИмяБина           - Строка            - Имя бина для атрибута class
//
// Возвращаемое значение:
//   Массив из Структура - Описания методов для перехватчиков
//
Функция СобратьМетодыКлассаПодсчитываемый(Желудь, ОпределениеЖелудя, ПрефиксМетрики, ИмяБина)

	ИмяАннотации = "Подсчитываемый";
	ПараметрЗначение = "Значение";
	СуффиксСчетчика = ".counted";

	Результат = Новый Массив();

	ОбъявленныеМетоды = ОбъявленныеМетодыПоИмени(ОпределениеЖелудя);

	Для Каждого ИмяМетода Из ИменаЭкспортныхМетодов(Желудь) Цикл

		ИмяМетрики = "";
		ОбъявленныйМетод = ОбъявленныеМетоды.Получить(НРег(ИмяМетода));
		Если ОбъявленныйМетод <> Неопределено Тогда
			АннотацияНаМетоде = РаботаСАннотациями.ПолучитьАннотацию(ОбъявленныйМетод, ИмяАннотации);
			Если АннотацияНаМетоде <> Неопределено Тогда
				ИмяМетрики = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
					АннотацияНаМетоде, ПараметрЗначение, "");
			КонецЕсли;
		КонецЕсли;

		Если ИмяМетрики = "" Тогда
			ИмяМетрики = ПрефиксМетрики + "." + ОтелУтилиты.Транслитерировать(ИмяМетода) + СуффиксСчетчика;
		КонецЕсли;

		ОтелУтилиты.ПроверитьИмяМетрики(ИмяМетрики);
		Описание = Новый Структура("ИмяМетода, ИмяМетрики, ИмяКласса", ИмяМетода, ИмяМетрики, ИмяБина);
		Результат.Добавить(Описание);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Объявленные в классе методы по имени в нижнем регистре: только у них есть аннотации.
//
// Параметры:
//   ОпределениеЖелудя - ОпределениеЖелудя - Метаданные бина
//
// Возвращаемое значение:
//   Соответствие - Имя метода в нижнем регистре и его описание
//
Функция ОбъявленныеМетодыПоИмени(ОпределениеЖелудя)

	Результат = Новый Соответствие();
	Для Каждого Метод Из ОпределениеЖелудя.Методы() Цикл
		Результат.Вставить(НРег(Метод.Имя), Метод);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Экспортные методы фактического объекта, кроме конструктора и служебных методов декоратора.
//
// Параметры:
//   Желудь - Произвольный - Экземпляр бина
//
// Возвращаемое значение:
//   Массив из Строка - Имена методов
//
Функция ИменаЭкспортныхМетодов(Желудь)

	Результат = Новый Массив();

	Для Каждого Метод Из ЛокальныйРефлектор.ПолучитьТаблицуМетодов(Желудь) Цикл

		Если НЕ Метод.Экспорт Тогда
			Продолжить;
		КонецЕсли;

		ИмяВНижнемРегистре = НРег(Метод.Имя);
		ЭтоСлужебныйМетодДекоратора = СтрНачинаетсяС(ИмяВНижнемРегистре, "декоратор_");
		Если ИмяВНижнемРегистре = "присозданииобъекта" ИЛИ ЭтоСлужебныйМетодДекоратора Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Метод.Имя);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СобратьМетодыСАннотациейПодсчитываемый(ОпределениеЖелудя, ИмяБина)

	ИмяАннотации = "Подсчитываемый";
	ПараметрЗначение = "Значение";
	СуффиксСчетчика = ".counted";

	Результат = Новый Массив();

	МетодыСАннотацией = ОпределениеЖелудя.НайтиМетодыСАннотациями(ИмяАннотации);
	Для Каждого Метод Из МетодыСАннотацией Цикл
		ИмяМетода = Метод.Имя;
		Аннотация = РаботаСАннотациями.ПолучитьАннотацию(Метод, ИмяАннотации);

		ИмяМетрики = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, ПараметрЗначение, "");
		Если ИмяМетрики = "" Тогда
			ИмяМетрики = ОтелУтилиты.Транслитерировать(ИмяБина) + "."
				+ ОтелУтилиты.Транслитерировать(ИмяМетода) + СуффиксСчетчика;
		КонецЕсли;

		ОтелУтилиты.ПроверитьИмяМетрики(ИмяМетрики);
		Описание = Новый Структура("ИмяМетода, ИмяМетрики, ИмяКласса", ИмяМетода, ИмяМетрики, ИмяБина);
		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Напильник для автоматического подсчета вызовов методов (аналог @Counted из Spring Boot).
// Обрабатывает бины с аннотацией &Подсчитываемый на методах или конструкторе.
// При каждом вызове метода инкрементирует счетчик с атрибутами code.function.name, code.namespace, result, exception.
// Имена метрик транслитерируются из кириллицы в ASCII автоматически.
// Если задано явное имя через параметр аннотации - используется оно (должно быть ASCII).
// SDK инициализируется лениво - только при первом бине с аннотацией &Подсчитываемый.
//
// Параметры:
//   ОтелМетр    - Табакерка - Обёртка для отложенного получения ОтелМетр
//   ОтелВключен - Булево, Строка - Признак включения инструментирования (otel.enabled)
//
&Напильник
&Порядок(500)
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин("ОтелМетр") ОтелМетр,
		&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = Ложь) ОтелВключен)
	ТабакеркаМетра = ОтелМетр;
	Включен = ЭтоВключено(ОтелВключен);
	ЛокальныйРефлектор = Новый Рефлектор();
КонецПроцедуры

// Приводит детальку otel.enabled к булеву.
//
// Из JSON и YAML деталька приходит булевом, а из переменной среды (OTEL_ENABLED=true) -
// строкой: провайдер ENV в configor отдаёт значения как есть, без приведения типа,
// а МенеджерПараметров не смотрит на тип значения по умолчанию.
// Неявное приведение в "Если Строка Тогда" покрывает только "true", "false" и "истина",
// а на "1", "yes" или пустой строке выбрасывает "Преобразование к типу 'Булево'
// не поддерживается" - и приложение не поднялось бы вовсе, потому что напильники
// обрабатывают желуди при старте.
//
// Параметры:
//   Значение - Булево, Строка, Неопределено - Значение детальки как его отдал configor
//
// Возвращаемое значение:
//   Булево - Истина, если инструментирование включено
//
Функция ЭтоВключено(Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	// Строгая семантика спецификации OTel: включает только явное "true".
	// Любое другое значение - "false", "1", "yes", пустая строка - выключено.
	Возврат НРег(СокрЛП(Строка(Значение))) = "true";

КонецФункции
