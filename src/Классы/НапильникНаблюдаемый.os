#Использовать opentelemetry
#Использовать annotations
#Использовать decorator

// Трассировщик OTel для создания спанов методов (ленивое получение из Табакерки).
Перем Трассировщик;
// Табакерка для отложенного получения трассировщика (SDK не инициализируется если не нужен).
Перем ТабакеркаТрассировщика;
// Рефлектор: читает методы желудя и устанавливает поля в сгенерированный декоратор.
Перем ЛокальныйРефлектор;
// Признак включения инструментирования напильниками OTel.
Перем Включен;
// РазворачивательАннотаций - разворачивает сырые аннотации, прочитанные рефлектором с желудя.
Перем РазворачивательАннотаций;

// Оборачивает желудь в декоратор с перехватчиками трассировки.
// Если инструментирование отключено или желудь не имеет методов с аннотацией @Наблюдаемый,
// возвращает желудь без изменений.
//
// Параметры:
//   Желудь             - Произвольный      - Экземпляр желудя
//   ОпределениеЖелудя  - ОпределениеЖелудя - Метаданные желудя (имя, аннотации, методы)
//
// Возвращаемое значение:
//   Произвольный - Оригинальный желудь или декоратор с перехватчиками трассировки
//
Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт

	Если НЕ Включен Тогда
		Возврат Желудь;
	КонецЕсли;

	МетодыДляИнструментирования = ПолучитьМетодыДляИнструментирования(Желудь, ОпределениеЖелудя);

	Если МетодыДляИнструментирования.Количество() = 0 Тогда
		Возврат Желудь;
	КонецЕсли;

	Если Трассировщик = Неопределено Тогда
		Трассировщик = ТабакеркаТрассировщика.Достать();
	КонецЕсли;

	ИмяЖелудя = ОпределениеЖелудя.Имя();

	Построитель = Новый ПостроительДекоратора(Желудь)
		.Импорт(Новый Импорт("opentelemetry"))
		.Поле(Новый Поле("Декоратор_Трассировщик"));

	Для Каждого ОписаниеМетода Из МетодыДляИнструментирования Цикл

		ИмяМетода = ОписаниеМетода.ИмяМетода;
		ИмяСпана = ОписаниеМетода.ИмяСпана;
		ВидСпана = ОписаниеМетода.ВидСпана;

		ТелоПеред = "Декоратор_ЛокальныйСпан = Декоратор_Трассировщик.НачатьСпан(""" + ИмяСпана + """";
		Если ВидСпана <> Неопределено Тогда
			ТелоПеред = ТелоПеред + ", " + ВидСпана;
		КонецЕсли;
		ТелоПеред = ТелоПеред + ");
			|Декоратор_ЛокальныйСпан.УстановитьАтрибут(""code.function.name"", """ + ИмяМетода + """);
			|Декоратор_ЛокальныйСпан.УстановитьАтрибут(""code.namespace"", """ + ИмяЖелудя + """);";

		АтрибутыПараметров = ОписаниеМетода.АтрибутыПараметров;
		Для Каждого АтрибутПараметра Из АтрибутыПараметров Цикл
			ТелоПеред = ТелоПеред + "
				|Декоратор_ЛокальныйСпан.УстановитьАтрибут(""" + АтрибутПараметра.КлючАтрибута
				+ """, " + АтрибутПараметра.ИмяПараметра + ");";
		КонецЦикла;

		ТелоПеред = ТелоПеред + "
			|Декоратор_ОбластьСпана = Декоратор_ЛокальныйСпан.СделатьТекущим();";

		ТелоПосле = "Декоратор_ОбластьСпана.Закрыть();
			|Декоратор_ЛокальныйСпан.Завершить();";

		ТелоИсключения =
			"Декоратор_ЛокальныйСпан.ЗаписатьИсключение(ИнформацияОбОшибке());
			|Декоратор_ЛокальныйСпан.УстановитьСтатус(ОтелКодСтатуса.Ошибка(), ОписаниеОшибки());
			|Декоратор_ОбластьСпана.Закрыть();
			|Декоратор_ЛокальныйСпан.Завершить();";

		ПерехватчикПеред = Новый Перехватчик(ИмяМетода)
			.ТипПерехватчика(ТипыПерехватчиковМетода.Перед)
			.Тело(ТелоПеред);
		ПерехватчикПосле = Новый Перехватчик(ИмяМетода)
			.ТипПерехватчика(ТипыПерехватчиковМетода.После)
			.Тело(ТелоПосле);
		ПерехватчикИсключения = Новый Перехватчик(ИмяМетода)
			.ТипПерехватчика(ТипыПерехватчиковМетода.ПослеВызоваИсключения)
			.Тело(ТелоИсключения);
		Построитель
			.Перехватчик(ПерехватчикПеред)
			.Перехватчик(ПерехватчикПосле)
			.Перехватчик(ПерехватчикИсключения);

	КонецЦикла;

	Декоратор = Построитель.Построить();
	ЛокальныйРефлектор.УстановитьСвойство(Декоратор, "Декоратор_Трассировщик", Трассировщик);

	Возврат Декоратор;

КонецФункции

Функция ПолучитьМетодыДляИнструментирования(Желудь, ОпределениеЖелудя)

	ИмяАннотации = "Наблюдаемый";
	ПараметрЗначение = "Значение";

	ИмяЖелудя = ОпределениеЖелудя.Имя();
	Завязь = ОпределениеЖелудя.Завязь();
	АннотацияНаКлассе = РаботаСАннотациями.ПолучитьАннотацию(Завязь.ДанныеМетода(), ИмяАннотации);

	МетодыЖелудя = ОтелМетодыЖелудя.МетодыЖелудя(Желудь, РазворачивательАннотаций);

	Если АннотацияНаКлассе = Неопределено Тогда
		Возврат СобратьМетодыСАннотациейНаблюдаемый(МетодыЖелудя, ИмяЖелудя);
	КонецЕсли;

	ПрефиксСпана = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(АннотацияНаКлассе, ПараметрЗначение, "");
	ВидСпанаКласса = ПолучитьВидСпанаИзАннотации(АннотацияНаКлассе);

	Если ПрефиксСпана = "" Тогда
		ПрефиксСпана = ИмяЖелудя;
	КонецЕсли;

	Возврат СобратьМетодыКлассаНаблюдаемый(МетодыЖелудя, ПрефиксСпана, ВидСпанаКласса);

КонецФункции

// Аннотация на конструкторе покрывает все экспортные методы желудя, включая добавленные
// декоратором: и методы, и их аннотации - имя спана, вид спана, атрибуты параметров -
// читаются рефлексией по самому экземпляру, а не из определения желудя, снятого по его
// типу, где методов декоратора нет.
//
// Параметры:
//   МетодыЖелудя   - Массив из СтрокаТаблицыЗначений - Методы желудя с аннотациями
//   ПрефиксСпана   - Строка - Имя, к которому приписывается имя метода
//   ВидСпанаКласса - Строка, Неопределено - Вид спана из аннотации на конструкторе
//
// Возвращаемое значение:
//   Массив из Структура - Описания методов для перехватчиков
//
Функция СобратьМетодыКлассаНаблюдаемый(МетодыЖелудя, ПрефиксСпана, ВидСпанаКласса)

	ИмяАннотации = "Наблюдаемый";
	ПараметрЗначение = "Значение";

	Результат = Новый Массив();

	Для Каждого Метод Из МетодыЖелудя Цикл

		ИмяМетода = Метод.Имя;

		ИмяСпана = "";
		ВидСпана = ВидСпанаКласса;

		АннотацияНаМетоде = РаботаСАннотациями.ПолучитьАннотацию(Метод, ИмяАннотации);
		Если АннотацияНаМетоде <> Неопределено Тогда
			ИмяСпана = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
				АннотацияНаМетоде, ПараметрЗначение, "");
			ВидСпана = ПолучитьВидСпанаИзАннотации(АннотацияНаМетоде);
		КонецЕсли;
		АтрибутыПараметров = ПолучитьАтрибутыПараметров(Метод);

		Если ИмяСпана = "" Тогда
			ИмяСпана = ПрефиксСпана + "." + ИмяМетода;
		КонецЕсли;

		Описание = Новый Структура("ИмяМетода, ИмяСпана, ВидСпана, АтрибутыПараметров");
		Описание.ИмяМетода = ИмяМетода;
		Описание.ИмяСпана = ИмяСпана;
		Описание.ВидСпана = ВидСпана;
		Описание.АтрибутыПараметров = АтрибутыПараметров;
		Результат.Добавить(Описание);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Методы, у которых аннотация висит на них самих, - в том числе пришедшие с декоратором.
//
// Параметры:
//   МетодыЖелудя - Массив из СтрокаТаблицыЗначений - Методы желудя с аннотациями
//   ИмяЖелудя    - Строка - Имя желудя, к которому приписывается имя метода
//
// Возвращаемое значение:
//   Массив из Структура - Описания методов для перехватчиков
//
Функция СобратьМетодыСАннотациейНаблюдаемый(МетодыЖелудя, ИмяЖелудя)

	ИмяАннотации = "Наблюдаемый";
	ПараметрЗначение = "Значение";

	Результат = Новый Массив();

	МетодыСАннотацией = РаботаСАннотациями.НайтиМетодыСАннотацией(МетодыЖелудя, ИмяАннотации);
	Для Каждого Метод Из МетодыСАннотацией Цикл
		ИмяМетода = Метод.Имя;
		Аннотация = РаботаСАннотациями.ПолучитьАннотацию(Метод, ИмяАннотации);

		ИмяСпана = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, ПараметрЗначение, "");
		ВидСпана = ПолучитьВидСпанаИзАннотации(Аннотация);

		Если ИмяСпана = "" Тогда
			ИмяСпана = ИмяЖелудя + "." + ИмяМетода;
		КонецЕсли;

		Описание = Новый Структура("ИмяМетода, ИмяСпана, ВидСпана, АтрибутыПараметров");
		Описание.ИмяМетода = ИмяМетода;
		Описание.ИмяСпана = ИмяСпана;
		Описание.ВидСпана = ВидСпана;
		Описание.АтрибутыПараметров = ПолучитьАтрибутыПараметров(Метод);
		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьАтрибутыПараметров(Метод)

	Результат = Новый Массив();

	Для Каждого ПараметрМетода Из Метод.Параметры Цикл
		Аннотация = РаботаСАннотациями.ПолучитьАннотацию(ПараметрМетода, "АтрибутСпана");
		Если Аннотация = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		КлючАтрибута = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Значение", "");
		Если КлючАтрибута = "" Тогда
			КлючАтрибута = ПараметрМетода.Имя;
		КонецЕсли;

		Описание = Новый Структура("КлючАтрибута, ИмяПараметра", КлючАтрибута, ПараметрМетода.Имя);
		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьВидСпанаИзАннотации(Аннотация)

	ВидСпанаСтрока = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "ВидСпана", "");

	Если ВидСпанаСтрока = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	ВидСпанаНРег = НРег(ВидСпанаСтрока);

	Если ВидСпанаНРег = "server" Или ВидСпанаНРег = "сервер" Тогда
		Возврат "ОтелВидСпана.Сервер()";
	ИначеЕсли ВидСпанаНРег = "client" Или ВидСпанаНРег = "клиент" Тогда
		Возврат "ОтелВидСпана.Клиент()";
	ИначеЕсли ВидСпанаНРег = "producer" Или ВидСпанаНРег = "производитель" Тогда
		Возврат "ОтелВидСпана.Производитель()";
	ИначеЕсли ВидСпанаНРег = "consumer" Или ВидСпанаНРег = "потребитель" Тогда
		Возврат "ОтелВидСпана.Потребитель()";
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Напильник для автоматического создания спанов OpenTelemetry.
// Обрабатывает желуди с аннотацией &Наблюдаемый на методах или конструкторе.
// При наличии аннотации оборачивает желудь в декоратор с перехватчиками,
// которые создают и завершают спаны вокруг вызовов методов.
//
// Параметры:
//   ОтелТрассировщик - Табакерка - Табакерка для отложенного получения трассировщика OTel
//   ОтелВключен      - Булево, Строка - Признак включения инструментирования (otel.enabled)
//   ВнедренныйРазворачиватель - РазворачивательАннотаций - Разворачиватель аннотаций осени
//
&Напильник
&Порядок(502)
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин("ОтелТрассировщик") ОтелТрассировщик,
		&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = Ложь) ОтелВключен,
		&Пластилин("РазворачивательАннотаций") ВнедренныйРазворачиватель)
	ТабакеркаТрассировщика = ОтелТрассировщик;
	Включен = ОтелДетальки.ЭтоВключено(ОтелВключен);
	ЛокальныйРефлектор = Новый Рефлектор();
	РазворачивательАннотаций = ВнедренныйРазворачиватель;
КонецПроцедуры
