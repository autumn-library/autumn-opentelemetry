#Использовать opentelemetry

// Детектор ресурса дистрибутива: атрибуты telemetry.distro.* семантических соглашений
// с именем и версией autumn-opentelemetry.

#Область ПрограммныйИнтерфейс

// Обнаруживает ресурс дистрибутива.
//
// Возвращаемое значение:
//   ОтелРесурс - ресурс с атрибутами telemetry.distro.name и telemetry.distro.version
//
Функция Обнаружить() Экспорт
	КаталогБиблиотеки = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..");
	Атрибуты = Новый Соответствие();
	Атрибуты.Вставить("telemetry.distro.name", "autumn-opentelemetry");
	Атрибуты.Вставить("telemetry.distro.version", ОтелУтилиты.ВерсияПакета(КаталогБиблиотеки));
	Возврат ОтелУтилиты.РесурсДетектора(Атрибуты, "https://opentelemetry.io/schemas/1.44.0");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&Желудь
&Прозвище("ДетекторРесурса")
&Спецификация("Инициализация")
&Реализует("ИнтерфейсДетекторРесурса")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти
