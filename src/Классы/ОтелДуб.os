#Использовать opentelemetry
#Использовать opentelemetry-instrumentation-entity

// Возвращает менеджер параметров приложения из контекста бинов Autumn.
//
// Параметры:
//   Поделка - Поделка - Контекст бинов Autumn
//
// Возвращаемое значение:
//   Произвольный - Менеджер параметров приложения
//
&Завязь
&Спецификация("Инициализация")
Функция МенеджерПараметров(&Пластилин Поделка) Экспорт
	Рефлектор = Новый Рефлектор();
	МенеджерПараметров = Рефлектор.ПолучитьСвойство(Поделка, "МенеджерПараметров");
	Возврат МенеджерПараметров;
КонецФункции

// Инициализирует OTel SDK на основе параметров приложения.
//
// Параметры:
//   Поделка - Поделка - Контекст бинов Autumn
//
// Возвращаемое значение:
//   ОтелSdk - Инициализированный SDK OpenTelemetry
//
&Завязь
&Спецификация("Инициализация")
Функция ОтелSdk(&Пластилин Поделка) Экспорт
	МенеджерПараметров = Поделка.НайтиЖелудь("МенеджерПараметров");
	Возврат ОтелАвтоконфигурация.Инициализировать(МенеджерПараметров);
КонецФункции

// Создает аппендер Logos, перенаправляющий логи через OTel Logs API.
//
// Параметры:
//   Поделка - Поделка - Контекст бинов Autumn
//
// Возвращаемое значение:
//   ОтелАппендерLogos - Аппендер для интеграции Logos с OTel
//
&Завязь
&Спецификация("Инициализация")
Функция ОтелАппендерLogos(&Пластилин Поделка) Экспорт
	ОтелSdk = Поделка.НайтиЖелудь("ОтелSdk");
	ОТелЛоггер = ОтелSdk.ПолучитьЛоггер("logos-bridge");
	Возврат Новый ОтелАппендерLogos(ОТелЛоггер);
КонецФункции

// Возвращает трассировщик OTel для инструментирования бинов Autumn.
//
// Параметры:
//   Поделка - Поделка - Контекст бинов Autumn
//
// Возвращаемое значение:
//   ОтелТрассировщик - Трассировщик для области "autumn-observed"
//
&Завязь
&Спецификация("Инициализация")
Функция ОтелТрассировщик(&Пластилин Поделка) Экспорт
	ОтелSdk = Поделка.НайтиЖелудь("ОтелSdk");
	Возврат ОтелSdk.ПолучитьТрассировщик("autumn-observed");
КонецФункции

// Возвращает метр OTel для сбора метрик бинов Autumn.
//
// Параметры:
//   Поделка - Поделка - Контекст бинов Autumn
//
// Возвращаемое значение:
//   ОтелМетр - Метр для области "autumn-metrics"
//
&Завязь
&Спецификация("Инициализация")
Функция ОтелМетр(&Пластилин Поделка) Экспорт
	ОтелSdk = Поделка.НайтиЖелудь("ОтелSdk");
	Возврат ОтелSdk.ПолучитьМетр("autumn-metrics");
КонецФункции

// Возвращает наблюдатель сущностей entity, переводящий события менеджеров сущностей в спаны
// и метрики OTel. Прозвище НаблюдательСущностей подхватывает autumn-data и подставляет
// наблюдатель во все менеджеры до их инициализации.
//
// Наблюдение выключается деталькой otel.entity.enabled (по умолчанию наследует otel.enabled):
// тогда завязь возвращает Неопределено, и в менеджеры ничего не попадает. SDK достается
// только при включенном наблюдении, чтобы запрос наблюдателей из autumn-data не поднимал
// SDK в выключенном приложении.
//
// Параметры:
//   Поделка - Поделка - Контекст бинов Autumn
//   ОтелВключен - Булево, Строка - Признак включения инструментирования (otel.enabled)
//   НаблюдениеВключено - Булево, Строка - Признак включения наблюдения entity (otel.entity.enabled)
//   ТекстЗапроса - Булево, Строка - Писать текст запроса в db.query.text (otel.entity.query-text), по умолчанию Ложь
//
// Возвращаемое значение:
//   ОтелНаблюдательСущностей - Наблюдатель для области "entity"
//   Неопределено - Наблюдение выключено
//
&Завязь(Тип = "ОтелНаблюдательСущностей")
&Прозвище("НаблюдательСущностей")
&Спецификация("Инициализация")
Функция ОтелНаблюдательСущностей(&Пластилин Поделка,
		&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = Ложь) ОтелВключен,
		&Деталька(Значение = "otel.entity.enabled", ЗначениеПоУмолчанию = "") НаблюдениеВключено,
		&Деталька(Значение = "otel.entity.query-text", ЗначениеПоУмолчанию = "") ТекстЗапроса) Экспорт

	Если НЕ ОтелДетальки.ЭтоВключено(ОтелВключен) ИЛИ НЕ ОтелДетальки.ЭтоВключено(НаблюдениеВключено, Истина) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОтелSdk = Поделка.НайтиЖелудь("ОтелSdk");
	// Текст запроса не санитизируется: произвольный текст из ВыполнитьСКоннектором может нести
	// литералы, поэтому по semconv db.query.text пишется только при явном включении.
	Настройки = Новый Структура("ТекстЗапроса", ОтелДетальки.ЭтоВключено(ТекстЗапроса));

	Возврат Новый ОтелНаблюдательСущностей(
		ОтелSdk.ПолучитьТрассировщик("entity"),
		ОтелSdk.ПолучитьМетр("entity"),
		Настройки
	);

КонецФункции

// Дуб (конфигурационный модуль) для регистрации бинов OTel в контейнере Autumn.
// Регистрирует: МенеджерПараметров, ОтелSdk, ОтелАппендерLogos, ОтелТрассировщик, ОтелМетр,
// ОтелНаблюдательСущностей.
//
&Дуб
&Спецификация("Инициализация")
Процедура ПриСозданииОбъекта()
КонецПроцедуры
