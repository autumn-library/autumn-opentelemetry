// Разбор методов желудя для напильников аннотаций.
//
// Аннотация на конструкторе покрывает все экспортные методы бина, включая унаследованные от
// родителя, поэтому список методов берется с самого объекта. Определение желудя - рефлексия
// по типу - знает только объявленные в классе методы, и нужно лишь ради аннотаций на них.

// Объявленные в классе методы по имени в нижнем регистре: только у них есть аннотации.
//
// Параметры:
//   ОпределениеЖелудя - ОпределениеЖелудя - Метаданные бина
//
// Возвращаемое значение:
//   Соответствие - Имя метода в нижнем регистре и его описание
//
Функция ОбъявленныеМетодыПоИмени(ОпределениеЖелудя) Экспорт

	Результат = Новый Соответствие();
	Для Каждого Метод Из ОпределениеЖелудя.Методы() Цикл
		Результат.Вставить(НРег(Метод.Имя), Метод);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Экспортные методы фактического объекта, кроме конструктора и служебных методов декоратора.
//
// Параметры:
//   Желудь - Произвольный - Экземпляр бина
//
// Возвращаемое значение:
//   Массив из Строка - Имена методов
//
Функция ИменаЭкспортныхМетодов(Желудь) Экспорт

	Результат = Новый Массив();
	ЛокальныйРефлектор = Новый Рефлектор();

	Для Каждого Метод Из ЛокальныйРефлектор.ПолучитьТаблицуМетодов(Желудь) Цикл

		Если НЕ Метод.Экспорт Тогда
			Продолжить;
		КонецЕсли;

		ИмяВНижнемРегистре = НРег(Метод.Имя);
		ЭтоСлужебныйМетодДекоратора = СтрНачинаетсяС(ИмяВНижнемРегистре, "декоратор_");
		Если ИмяВНижнемРегистре = "присозданииобъекта" ИЛИ ЭтоСлужебныйМетодДекоратора Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Метод.Имя);

	КонецЦикла;

	Возврат Результат;

КонецФункции
