// Приведение деталек otel.* к булеву.
//
// Из JSON и YAML деталька приходит булевом, а из переменной среды (OTEL_ENABLED=true) -
// строкой: провайдер ENV в configor отдаёт значения как есть, без приведения типа,
// а МенеджерПараметров не смотрит на тип значения по умолчанию.
// Неявное приведение в "Если Строка Тогда" покрывает только "true", "false" и "истина",
// а на "1", "yes" или пустой строке выбрасывает "Преобразование к типу 'Булево'
// не поддерживается" - и приложение не поднялось бы вовсе, потому что напильники
// обрабатывают желуди при старте.

// Определяет, включает ли значение детальки функцию.
//
// Строгая семантика спецификации OTel: включает только явное "true" (или булево Истина).
// Любое другое значение - "false", "1", "yes" - выключено.
//
// Параметры:
//   Значение - Булево, Строка, Неопределено - Значение детальки как его отдал configor.
//   ПоУмолчанию - Булево - Результат, если деталька не задана: Неопределено или пустая строка.
//
// Возвращаемое значение:
//   Булево - Истина, если функция включена.
//
Функция ЭтоВключено(Знач Значение, Знач ПоУмолчанию = Ложь) Экспорт

	Если Значение = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Строковое = НРег(СокрЛП(Строка(Значение)));
	Если Строковое = "" Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Возврат Строковое = "true";

КонецФункции
