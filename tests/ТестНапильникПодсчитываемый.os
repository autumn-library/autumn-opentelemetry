// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать autumn
#Использовать asserts
#Использовать opentelemetry
#Использовать ".."
#Использовать "."

Перем Поделка;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт
	НастройкиОтел = Новый Соответствие();
	НастройкиОтел.Вставить("enabled", Истина);
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("otel", НастройкиОтел);
	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();
КонецПроцедуры

&Тест
Процедура НапильникПодсчитываемый_МетодВыполняетсяБезОшибок() Экспорт

	// Когда
	Служба = Поделка.НайтиЖелудь("ПодсчитываемаяСлужба");
	Результат = Служба.ОбработатьЗапрос();

	// Тогда - метод завершился без ошибок, счётчик инкрементирован
	Ожидаем.Что(Результат).Равно(Истина);

КонецПроцедуры

&Тест
Процедура НапильникПодсчитываемый_МетодВызываетсяНесколькоРаз() Экспорт

	// Дано
	Служба = Поделка.НайтиЖелудь("ПодсчитываемаяСлужба");

	// Когда - несколько вызовов подряд
	Служба.ОбработатьЗапрос();
	Служба.ОбработатьЗапрос();
	Служба.ОбработатьЗапрос();

	// Тогда - все вызовы завершились без ошибок
	Ожидаем.Что(Истина).Равно(Истина);

КонецПроцедуры

&Тест
Процедура НапильникПодсчитываемый_МетодУровняМетода_ВыполняетсяБезОшибок() Экспорт

	// Когда
	Служба = Поделка.НайтиЖелудь("ПодсчитываемаяСлужбаМетод");
	Результат = Служба.ПодсчитываемыйМетод();

	// Тогда
	Ожидаем.Что(Результат).Равно("подсчитано");

КонецПроцедуры

&Тест
Процедура НапильникПодсчитываемый_МетодСЯвнымИменемМетрики_ВыполняетсяБезОшибок() Экспорт

	// Когда
	Служба = Поделка.НайтиЖелудь("ПодсчитываемаяСлужбаМетод");
	Результат = Служба.МетодСЯвнымИменем();

	// Тогда
	Ожидаем.Что(Результат).Равно("явное-имя");

КонецПроцедуры

&Тест
Процедура НапильникПодсчитываемый_ПриОтелОтключен_МетодВыполняетсяБезОборачивания() Экспорт

// Дано - otel.enabled не задан (по умолчанию Ложь)
ПустойСовет = Новый СоветДругогоМастера();
ПоделкаБезОтел = Новый Поделка(ПустойСовет);
ПоделкаБезОтел.ЗапуститьПриложение();

// Когда
Служба = ПоделкаБезОтел.НайтиЖелудь("ПодсчитываемаяСлужба");
Результат = Служба.ОбработатьЗапрос();

// Тогда - метод работает, бин не обёрнут декоратором → SDK не инициализировался
Ожидаем.Что(Результат).Равно(Истина);
Ожидаем.Что(Строка(ТипЗнч(Служба))).Равно("ПодсчитываемаяСлужба");

КонецПроцедуры

&Тест
Процедура НапильникПодсчитываемый_ПриСтроковойДетальке_БинОборачивается() Экспорт

	// Дано - otel.enabled задан строкой "true": провайдер переменных среды в configor
	// отдаёт значения как есть, без приведения к булеву
	ПоделкаСоСтрокой = ПоделкаСДеталькойOtelEnabled("true");

	// Когда
	Служба = ПоделкаСоСтрокой.НайтиЖелудь("ПодсчитываемаяСлужба");
	Результат = Служба.ОбработатьЗапрос();

	// Тогда - бин обёрнут декоратором, инструментирование включено
	Ожидаем.Что(Результат).Равно(Истина);
	Ожидаем.Что(Строка(ТипЗнч(Служба))).Не_().Равно("ПодсчитываемаяСлужба");

КонецПроцедуры

&Тест
Процедура НапильникПодсчитываемый_ПриНеРаспознаннойСтроковойДетальке_БинНеОборачивается() Экспорт

	// Дано - значение, которое OneScript не умеет неявно привести к булеву.
	// По спецификации OTel включает только явное "true", всё остальное - выключено,
	// а не ошибка "Преобразование к типу 'Булево' не поддерживается" при старте
	ПоделкаСЕдиницей = ПоделкаСДеталькойOtelEnabled("1");

	// Когда
	Служба = ПоделкаСЕдиницей.НайтиЖелудь("ПодсчитываемаяСлужба");
	Результат = Служба.ОбработатьЗапрос();

	// Тогда - приложение поднялось, бин не обёрнут декоратором
	Ожидаем.Что(Результат).Равно(Истина);
	Ожидаем.Что(Строка(ТипЗнч(Служба))).Равно("ПодсчитываемаяСлужба");

КонецПроцедуры

// Создаёт поделку с деталькой otel.enabled, равной переданному значению.
&Тест
Процедура НапильникПодсчитываемый_УнаследованныеМетоды_ТожеСчитаются() Экспорт

	// Дано - желудь-наследник: в определении виден только собственный метод
	Метр = Поделка.НайтиЖелудь("ОтелМетр");
	Служба = Поделка.НайтиЖелудь("СлужбаПодсчитываемаяСНаследованием");

	// Когда
	Результат = Служба.УнаследованныйМетод();

	// Тогда
	Ожидаем.Что(Результат).Равно("унаследовано");
	Читатель = Новый ЧитательИнструментов;
	Ожидаем.Что(Читатель.ЕстьИнструментПоМетоду(Метр, "УнаследованныйМетод"),
		"Инструменты: " + Читатель.Имена(Метр)).Равно(Истина);

КонецПроцедуры

Функция ПоделкаСДеталькойOtelEnabled(Знач ЗначениеДетальки)

	НастройкиОтел = Новый Соответствие();
	НастройкиОтел.Вставить("enabled", ЗначениеДетальки);
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("otel", НастройкиОтел);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);

	НоваяПоделка = Новый Поделка(Совет);
	НоваяПоделка.ЗапуститьПриложение();

	Возврат НоваяПоделка;

КонецФункции
