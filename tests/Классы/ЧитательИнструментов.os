// Чтение инструментов метра в тестах напильников &Замеряемый и &Подсчитываемый.
//
// Имена инструментов собираются из транслитерированного имени желудя и метода, поэтому тест
// не предсказывает имя целиком, а ищет в нем транслитерацию имени метода.

#Использовать opentelemetry

// Есть ли у метра инструмент, имя которого содержит транслитерацию имени метода.
//
// Параметры:
//   Метр      - ОтелМетр - Метр, инструменты которого читаются.
//   ИмяМетода - Строка   - Имя метода как оно написано в классе.
//   Суффикс   - Строка   - Чем должно оканчиваться имя инструмента, если важен его вид.
//
// Возвращаемое значение:
//   Булево - Истина, если такой инструмент зарегистрирован.
//
Функция ЕстьИнструментПоМетоду(Знач Метр, Знач ИмяМетода, Знач Суффикс = "") Экспорт

	Возврат НайтиИнструментПоМетоду(Метр, ИмяМетода, Суффикс) <> Неопределено;

КонецФункции

// Инструмент, имя которого содержит транслитерацию имени метода.
//
// Параметры:
//   Метр      - ОтелМетр - Метр, инструменты которого читаются.
//   ИмяМетода - Строка   - Имя метода как оно написано в классе.
//   Суффикс   - Строка   - Чем должно оканчиваться имя инструмента, если важен его вид.
//
// Возвращаемое значение:
//   ИнтерфейсИнструментМетрик, Неопределено - Найденный инструмент.
//
Функция НайтиИнструментПоМетоду(Знач Метр, Знач ИмяМетода, Знач Суффикс = "") Экспорт

	Кусок = ОтелУтилиты.Транслитерировать(ИмяМетода);
	Для Каждого Инструмент Из Метр.Инструменты() Цикл

		ИмяИнструмента = НРег(Инструмент.Имя());
		Если СтрНайти(ИмяИнструмента, НРег(Кусок)) = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Суффикс <> "" И НЕ СтрЗаканчиваетсяНа(ИмяИнструмента, НРег(Суффикс)) Тогда
			Продолжить;
		КонецЕсли;

		Возврат Инструмент;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Инструмент с точно таким именем - когда имя задано аннотацией и предсказуемо целиком.
//
// Параметры:
//   Метр           - ОтелМетр - Метр, инструменты которого читаются.
//   ИмяИнструмента - Строка   - Имя метрики.
//
// Возвращаемое значение:
//   ИнтерфейсИнструментМетрик, Неопределено - Найденный инструмент.
//
Функция НайтиИнструмент(Знач Метр, Знач ИмяИнструмента) Экспорт

	Для Каждого Инструмент Из Метр.Инструменты() Цикл
		Если Инструмент.Имя() = ИмяИнструмента Тогда
			Возврат Инструмент;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Атрибуты единственной точки инструмента с точно таким именем.
//
// Параметры:
//   Метр           - ОтелМетр - Метр, инструменты которого читаются.
//   ИмяИнструмента - Строка   - Имя метрики.
//
// Возвращаемое значение:
//   Соответствие - Ключ атрибута -> значение.
//
Функция АтрибутыТочки(Знач Метр, Знач ИмяИнструмента) Экспорт

	Инструмент = НайтиИнструмент(Метр, ИмяИнструмента);
	Если Инструмент = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Инструмент %1 не найден, есть: %2", ИмяИнструмента, Имена(Метр));
	КонецЕсли;

	Данные = Инструмент.Собрать(
		Метр.Ресурс(), Метр.ОбластьИнструментирования(), Инструмент.Имя(), Инструмент.Описание());
	Точки = Данные.ТочкиДанных();
	Если Точки.Количество() <> 1 Тогда
		ВызватьИсключение СтрШаблон("У инструмента %1 точек: %2", ИмяИнструмента, Точки.Количество());
	КонецЕсли;

	Результат = Новый Соответствие;
	Для Каждого Пара Из Точки[0].Получить("attributes") Цикл
		Для Каждого Типизированное Из Пара.Получить("value") Цикл
			Результат.Вставить(Пара.Получить("key"), Типизированное.Значение);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Имена зарегистрированных инструментов через запятую - для сообщений об ошибках проверок.
//
// Параметры:
//   Метр - ОтелМетр - Метр, инструменты которого читаются.
//
// Возвращаемое значение:
//   Строка - Имена.
//
Функция Имена(Знач Метр) Экспорт

	Имена = Новый Массив;
	Для Каждого Инструмент Из Метр.Инструменты() Цикл
		Имена.Добавить(Инструмент.Имя());
	КонецЦикла;

	Возврат СтрСоединить(Имена, ", ");

КонецФункции

Процедура ПриСозданииОбъекта()
КонецПроцедуры
