// Экспортер спанов для тестов: складывает завершенные спаны в массив.
//
// Желудь, чтобы ТестовыйОтелДуб подключил его к провайдеру трассировки, а тесты читали спаны.

// Массив из ОтелСпан - Экспортированные спаны в порядке завершения.
// Читаются методами ПоИмени и Имена: экспортная переменная стала бы источником
// трудновоспроизводимых ошибок.
Перем Спаны;

&Желудь
&Реализует("ИнтерфейсЭкспортерСпанов")
Процедура ПриСозданииОбъекта()
	Спаны = Новый Массив;
КонецПроцедуры

Функция Экспортировать(МассивСпанов, Таймаут = Неопределено) Экспорт // BSLLS:UnusedParameters-off
	Для Каждого Спан Из МассивСпанов Цикл
		Спаны.Добавить(Спан);
	КонецЦикла;
	Возврат ОтелРезультатыЭкспорта.Успех();
КонецФункции

Функция СброситьБуфер(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
	Возврат Истина;
КонецФункции

Функция Закрыть() Экспорт
	Возврат Истина;
КонецФункции

// Экспортированные спаны с таким именем в порядке завершения.
//
// Параметры:
//   Имя - Строка - Имя спана.
//
// Возвращаемое значение:
//   Массив из ОтелСпан - Спаны.
//
Функция ПоИмени(Знач Имя) Экспорт
	Результат = Новый Массив;
	Для Каждого Спан Из Спаны Цикл
		Если Спан.Имя() = Имя Тогда
			Результат.Добавить(Спан);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Имена экспортированных спанов через запятую - для сообщений об ошибках проверок.
//
// Возвращаемое значение:
//   Строка - Имена.
//
Функция Имена() Экспорт
	Имена = Новый Массив;
	Для Каждого Спан Из Спаны Цикл
		Имена.Добавить(Спан.Имя());
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");
КонецФункции
