// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать autumn
#Использовать asserts
#Использовать opentelemetry
#Использовать ".."
#Использовать "."

Перем Поделка;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт
	ОтелКонтекст.Очистить();
	НастройкиОтел = Новый Соответствие();
	НастройкиОтел.Вставить("enabled", Истина);
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("otel", НастройкиОтел);
	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ОтелКонтекст.Очистить();
КонецПроцедуры

&Тест
Процедура НапильникНаблюдаемый_МетодВыполняетсяБезОшибок() Экспорт

	// Когда
	Служба = Поделка.НайтиЖелудь("НаблюдаемаяСлужба");
	Результат = Служба.ВыполнитьОперацию("тест");

	// Тогда
	Ожидаем.Что(Результат).Равно("тест_выполнено");

КонецПроцедуры

&Тест
Процедура НапильникНаблюдаемый_МетодУровняМетода_ВыполняетсяБезОшибок() Экспорт

	// Когда
	Служба = Поделка.НайтиЖелудь("НаблюдаемаяСлужбаМетод");
	Результат = Служба.НаблюдаемыйМетод();

	// Тогда
	Ожидаем.Что(Результат).Равно("наблюдаемый");

КонецПроцедуры

&Тест
Процедура НапильникНаблюдаемый_МетодСВидомСпана_ВыполняетсяБезОшибок() Экспорт

	// Когда
	Служба = Поделка.НайтиЖелудь("НаблюдаемаяСлужбаМетод");
	Результат = Служба.МетодСервер();

	// Тогда
	Ожидаем.Что(Результат).Равно("сервер");

КонецПроцедуры

&Тест
Процедура НапильникНаблюдаемый_МетодСАтрибутомПараметра_ВыполняетсяБезОшибок() Экспорт

	// Когда
	Служба = Поделка.НайтиЖелудь("НаблюдаемаяСлужбаМетод");
	Результат = Служба.МетодСАтрибутом("ORD-1", "USR-7");

	// Тогда
	Ожидаем.Что(Результат).Равно("ORD-1/USR-7");

КонецПроцедуры

&Тест
Процедура НапильникНаблюдаемый_МетодСОшибкой_ПрокидываетИсключение() Экспорт

	// Когда
	Служба = Поделка.НайтиЖелудь("НаблюдаемаяСлужбаМетод");
	БылоИсключение = Ложь;
	Попытка
		Служба.МетодСОшибкой();
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	// Тогда
	Ожидаем.Что(БылоИсключение).Равно(Истина);

КонецПроцедуры

&Тест
Процедура НапильникНаблюдаемый_ПриОтелОтключен_МетодВыполняетсяБезОборачивания() Экспорт

	// Дано - otel.enabled не задан (по умолчанию Ложь)
	ПустойСовет = Новый СоветДругогоМастера();
	ПоделкаБезОтел = Новый Поделка(ПустойСовет);
	ПоделкаБезОтел.ЗапуститьПриложение();

	// Когда
	Служба = ПоделкаБезОтел.НайтиЖелудь("НаблюдаемаяСлужба");
	Результат = Служба.ВыполнитьОперацию("тест");

	// Тогда - метод работает, бин не обёрнут декоратором → SDK не инициализировался
	Ожидаем.Что(Результат).Равно("тест_выполнено");
	Ожидаем.Что(Строка(ТипЗнч(Служба))).Равно("НаблюдаемаяСлужба");

КонецПроцедуры

&Тест
Процедура НапильникНаблюдаемый_ПриСтроковойДетальке_БинОборачивается() Экспорт

	// Дано - otel.enabled задан строкой "true": провайдер переменных среды в configor
	// отдаёт значения как есть, без приведения к булеву
	ПоделкаСоСтрокой = ПоделкаСДеталькойOtelEnabled("true");

	// Когда
	Служба = ПоделкаСоСтрокой.НайтиЖелудь("НаблюдаемаяСлужба");
	Результат = Служба.ВыполнитьОперацию("тест");

	// Тогда - бин обёрнут декоратором, инструментирование включено
	Ожидаем.Что(Результат).Равно("тест_выполнено");
	Ожидаем.Что(Строка(ТипЗнч(Служба))).Не_().Равно("НаблюдаемаяСлужба");

КонецПроцедуры

&Тест
Процедура НапильникНаблюдаемый_ПриНеРаспознаннойСтроковойДетальке_БинНеОборачивается() Экспорт

	// Дано - значение, которое OneScript не умеет неявно привести к булеву.
	// По спецификации OTel включает только явное "true", всё остальное - выключено,
	// а не ошибка "Преобразование к типу 'Булево' не поддерживается" при старте
	ПоделкаСЕдиницей = ПоделкаСДеталькойOtelEnabled("1");

	// Когда
	Служба = ПоделкаСЕдиницей.НайтиЖелудь("НаблюдаемаяСлужба");
	Результат = Служба.ВыполнитьОперацию("тест");

	// Тогда - приложение поднялось, бин не обёрнут декоратором
	Ожидаем.Что(Результат).Равно("тест_выполнено");
	Ожидаем.Что(Строка(ТипЗнч(Служба))).Равно("НаблюдаемаяСлужба");

КонецПроцедуры

&Тест
Процедура НапильникНаблюдаемый_УнаследованныеМетоды_ТожеПолучаютСпан() Экспорт

	// Дано - желудь-наследник: в определении виден только собственный метод,
	// метод родителя есть лишь у собранного объекта
	Экспортер = Поделка.НайтиЖелудь("ЭкспортерСпановВПамяти");
	Служба = Поделка.НайтиЖелудь("СлужбаСУнаследованнымиМетодами");

	// Когда
	Свое = Служба.СобственныйМетод();
	Унаследованное = Служба.УнаследованныйМетод();

	// Тогда
	Ожидаем.Что(Свое).Равно("свое");
	Ожидаем.Что(Унаследованное).Равно("унаследовано");

	Ожидаем.Что(Экспортер.ПоИмени("СлужбаСУнаследованнымиМетодами.СобственныйМетод"),
		"Собственный метод, экспортированы: " + ИменаСпанов(Экспортер)).ИмеетДлину(1);

	Ожидаем.Что(Экспортер.ПоИмени("СлужбаСУнаследованнымиМетодами.УнаследованныйМетод"),
		"Унаследованный метод, экспортированы: " + ИменаСпанов(Экспортер)).ИмеетДлину(1);

КонецПроцедуры

Функция ИменаСпанов(Знач Экспортер)
	Имена = Новый Массив;
	Для Каждого Спан Из Экспортер.Спаны Цикл
		Имена.Добавить(Спан.Имя());
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");
КонецФункции

// Создаёт поделку с деталькой otel.enabled, равной переданному значению.
Функция ПоделкаСДеталькойOtelEnabled(Знач ЗначениеДетальки)

	НастройкиОтел = Новый Соответствие();
	НастройкиОтел.Вставить("enabled", ЗначениеДетальки);
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("otel", НастройкиОтел);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);

	НоваяПоделка = Новый Поделка(Совет);
	НоваяПоделка.ЗапуститьПриложение();

	Возврат НоваяПоделка;

КонецФункции
