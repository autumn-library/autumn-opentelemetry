// Завязь ОтелНаблюдательИсточникаДанных в ОтелДуб: наблюдатель entity с прозвищем
// НаблюдательИсточникаДанных. Что наблюдатель пишет в спаны и метрики, проверяет
// opentelemetry-instrumentation-entity; здесь - создание желудя и выключение настройками.
//
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать autumn
#Использовать asserts
#Использовать opentelemetry
#Использовать opentelemetry-instrumentation-entity
#Использовать ".."
#Использовать "."

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&Тест
Процедура ЗавязьНаблюдателя_ПриВключенномОтел_ОтдаетНаблюдательСПрозвищем() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Истина, Неопределено);

	// Когда
	Наблюдатель = Поделка.НайтиЖелудь("ОтелНаблюдательИсточникаДанных");
	ПоПрозвищу = Поделка.НайтиЖелуди("НаблюдательИсточникаДанных");

	// Тогда
	Ожидаем.Что(Наблюдатель).ИмеетТип("ОтелНаблюдательИсточникаДанных");
	Ожидаем.Что(ПоПрозвищу).ИмеетДлину(1);
	Ожидаем.Что(ПоПрозвищу[0]).Равно(Наблюдатель);

КонецПроцедуры

&Тест
Процедура ЗавязьНаблюдателя_ПриВыключенномНаблюденииEntity_ОтдаетНеопределено() Экспорт

	// Дано - отел включен, а наблюдение за entity выключено
	Поделка = ПоделкаСДетальками(Истина, Ложь);

	// Когда
	Наблюдатель = Поделка.НайтиЖелудь("ОтелНаблюдательИсточникаДанных");

	// Тогда - завязь вернула Неопределено, в коллекции по прозвищу желудя нет
	Ожидаем.Что(Наблюдатель).Равно(Неопределено);
	Ожидаем.Что(Поделка.НайтиЖелуди("НаблюдательИсточникаДанных")).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ЗавязьНаблюдателя_ПриВыключенномОтел_ОтдаетНеопределено() Экспорт

	// Дано - otel.enabled не задан
	Поделка = ПоделкаСДетальками(Неопределено, Неопределено);

	// Когда-Тогда
	Ожидаем.Что(Поделка.НайтиЖелудь("ОтелНаблюдательИсточникаДанных")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЗавязьНаблюдателя_ПриСтроковойДетальке_Включается() Экспорт

	// Дано - переменные среды отдают строки
	Поделка = ПоделкаСДетальками("true", "true");

	// Когда-Тогда
	Ожидаем.Что(Поделка.НайтиЖелудь("ОтелНаблюдательИсточникаДанных")).ИмеетТип("ОтелНаблюдательИсточникаДанных");

КонецПроцедуры

&Тест
Процедура ЗавязьНаблюдателя_ОшибкаОперации_ПишетсяЗаписьюЛога() Экспорт

	// Дано - наблюдатель зарегистрирован на источнике данных
	Поделка = ПоделкаСДетальками(Истина, Неопределено);
	Источник = Новый ИсточникДанных("тест", Тип("КоннекторInMemory"), Строка(Новый УникальныйИдентификатор));
	Источник.ДобавитьНаблюдателя(Поделка.НайтиЖелудь("ОтелНаблюдательИсточникаДанных"));
	МенеджерСущностей = Новый МенеджерСущностей(Источник);
	МенеджерСущностей.Инициализировать();

	// Когда - у коннектора InMemory нет ВыполнитьЗапрос, операция падает
	Параметры = Новый Массив;
	Параметры.Добавить("Коннектор -> Коннектор.ВыполнитьЗапрос(""SELECT 1"")");
	Ожидаем.Что(МенеджерСущностей).Метод("ВыполнитьСКоннектором", Параметры).ВыбрасываетИсключение();
	МенеджерСущностей.Закрыть();

	// Тогда - наблюдатель получил логгер SDK и записал исключение операции
	ПроцессорЛогов = Поделка.НайтиЖелудь("ПроцессорЛоговВПамяти");
	Ожидаем.Что(ПроцессорЛогов.ПоИмениСобытия("entity.operation.exception")).ИмеетДлину(1);

КонецПроцедуры

// Служебные

Функция ПоделкаСДетальками(Знач ОтелВключен, Знач EntityВключен)

	НастройкиEntity = Новый Соответствие();
	Если EntityВключен <> Неопределено Тогда
		НастройкиEntity.Вставить("enabled", EntityВключен);
	КонецЕсли;

	НастройкиОтел = Новый Соответствие();
	Если ОтелВключен <> Неопределено Тогда
		НастройкиОтел.Вставить("enabled", ОтелВключен);
	КонецЕсли;
	НастройкиОтел.Вставить("entity", НастройкиEntity);

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("otel", НастройкиОтел);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка;

КонецФункции
