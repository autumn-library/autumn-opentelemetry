// Завязь ОтелНаблюдательИсточникаДанных в ОтелДуб: наблюдатель entity с прозвищем
// НаблюдательИсточникаДанных, который autumn-data регистрирует на всех источниках данных.
//
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать autumn
#Использовать autumn-data
#Использовать asserts
#Использовать opentelemetry
#Использовать opentelemetry-instrumentation-entity
#Использовать ".."
#Использовать "."

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&Тест
Процедура ЗавязьНаблюдателя_ПриВключенномОтел_ОтдаетНаблюдательСПрозвищем() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Истина, Неопределено);

	// Когда
	Наблюдатель = Поделка.НайтиЖелудь("ОтелНаблюдательИсточникаДанных");
	ПоПрозвищу = Поделка.НайтиЖелуди("НаблюдательИсточникаДанных");

	// Тогда
	Ожидаем.Что(Наблюдатель).ИмеетТип("ОтелНаблюдательИсточникаДанных");
	Ожидаем.Что(ПоПрозвищу).ИмеетДлину(1);
	Ожидаем.Что(ПоПрозвищу[0]).Равно(Наблюдатель);

КонецПроцедуры

&Тест
Процедура ЗавязьНаблюдателя_ПриВыключенномНаблюденииEntity_ОтдаетНеопределено() Экспорт

	// Дано - otel.enabled = true, otel.entity.enabled = false
	Поделка = ПоделкаСДетальками(Истина, Ложь);

	// Когда
	Наблюдатель = Поделка.НайтиЖелудь("ОтелНаблюдательИсточникаДанных");

	// Тогда - завязь вернула Неопределено, в коллекции по прозвищу желудя нет
	Ожидаем.Что(Наблюдатель).Равно(Неопределено);
	Ожидаем.Что(Поделка.НайтиЖелуди("НаблюдательИсточникаДанных")).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ЗавязьНаблюдателя_ПриВыключенномОтел_ОтдаетНеопределено() Экспорт

	// Дано - otel.enabled не задан
	Поделка = ПоделкаСДетальками(Неопределено, Неопределено);

	// Когда-Тогда
	Ожидаем.Что(Поделка.НайтиЖелудь("ОтелНаблюдательИсточникаДанных")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЗавязьНаблюдателя_ПриСтроковойДетальке_Включается() Экспорт

	// Дано - переменные среды отдают строки
	Поделка = ПоделкаСДетальками("true", "true");

	// Когда-Тогда
	Ожидаем.Что(Поделка.НайтиЖелудь("ОтелНаблюдательИсточникаДанных")).ИмеетТип("ОтелНаблюдательИсточникаДанных");

КонецПроцедуры

&Тест
Процедура ЗавязьНаблюдателя_СAutumnData_МенеджерОтдаетСпаныОперацийИЗапросов() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Истина, Неопределено);
	Экспортер = Поделка.НайтиЖелудь("ЭкспортерСпановВПамяти");
	МенеджерСущностей = Поделка.НайтиЖелудь("МенеджерСущностей");

	// Когда
	Лицо = МенеджерСущностей.СоздатьЭлемент(Тип("ФизическоеЛицо"));
	Лицо.Имя = "Пушкин";
	МенеджерСущностей.Сохранить(Лицо);

	// Тогда - наблюдатель зарегистрирован до инициализации и видит ее
	Ожидаем.Что(Экспортер.ПоИмени("Инициализировать"), Экспортер.Имена()).ИмеетДлину(1);
	Операция = Экспортер.ПоИмени("Сохранить ФизическоеЛицо");
	Ожидаем.Что(Операция).ИмеетДлину(1);
	Запрос = Экспортер.ПоИмени("INSERT ФизическиеЛица");
	Ожидаем.Что(Запрос).ИмеетДлину(1);
	Ожидаем.Что(Запрос[0].ИдРодительскогоСпана()).Равно(Операция[0].КонтекстСпана().ИдСпана());
	Ожидаем.Что(Запрос[0].Атрибуты().Получить("db.system.name")).Равно("inmemory");

КонецПроцедуры

&Тест
Процедура ЗавязьНаблюдателя_ТекстЗапросаПоУмолчаниюНеПишется() Экспорт

	// Дано - otel.entity.query-text не задан; SQLite, потому что у InMemory текста запроса нет
	Поделка = ПоделкаСДетальками(Истина, Неопределено, Неопределено, Истина);

	// Когда
	Запрос = СпанЗапросаПослеСохранения(Поделка);

	// Тогда - текст запроса может содержать литералы, поэтому без явного включения в телеметрию не идет
	Ожидаем.Что(Запрос.Атрибуты().Получить("db.query.text")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЗавязьНаблюдателя_ТекстЗапросаВключаетсяДеталькой() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Истина, Неопределено, "true", Истина);

	// Когда
	Запрос = СпанЗапросаПослеСохранения(Поделка);

	// Тогда
	Ожидаем.Что(Запрос.Атрибуты().Получить("db.query.text")).Содержит("INSERT");

КонецПроцедуры

// Служебные

// Сохраняет сущность через менеджер поделки и возвращает спан ее INSERT-запроса.
Функция СпанЗапросаПослеСохранения(Поделка)

	Экспортер = Поделка.НайтиЖелудь("ЭкспортерСпановВПамяти");
	МенеджерСущностей = Поделка.НайтиЖелудь("МенеджерСущностей");

	Лицо = МенеджерСущностей.СоздатьЭлемент(Тип("ФизическоеЛицо"));
	Лицо.Имя = "Пушкин";
	МенеджерСущностей.Сохранить(Лицо);

	Запросы = Экспортер.ПоИмени("INSERT ФизическиеЛица");
	Ожидаем.Что(Запросы, Экспортер.Имена()).ИмеетДлину(1);

	Возврат Запросы[0];

КонецФункции

// Параметры:
//   ОтелВключен - Булево, Строка, Неопределено - Значение otel.enabled; Неопределено - не задавать
//   EntityВключен - Булево, Строка, Неопределено - Значение otel.entity.enabled; Неопределено - не задавать
//   ТекстЗапроса - Булево, Строка, Неопределено - Значение otel.entity.query-text; Неопределено - не задавать
//   SQLite - Булево - Истина: источник данных на временном файле SQLite, иначе КоннекторInMemory
Функция ПоделкаСДетальками(Знач ОтелВключен, Знач EntityВключен, Знач ТекстЗапроса = Неопределено, Знач SQLite = Ложь)

	НастройкиEntity = Новый Соответствие();
	Если EntityВключен <> Неопределено Тогда
		НастройкиEntity.Вставить("enabled", EntityВключен);
	КонецЕсли;
	Если ТекстЗапроса <> Неопределено Тогда
		НастройкиEntity.Вставить("query-text", ТекстЗапроса);
	КонецЕсли;

	НастройкиОтел = Новый Соответствие();
	Если ОтелВключен <> Неопределено Тогда
		НастройкиОтел.Вставить("enabled", ОтелВключен);
	КонецЕсли;
	НастройкиОтел.Вставить("entity", НастройкиEntity);

	ИсточникДанных = Новый Соответствие();
	Если SQLite Тогда
		ИсточникДанных.Вставить("ТипКоннектора", "КоннекторSQLite");
		ИсточникДанных.Вставить("СтрокаСоединения", "Data Source=" + ПолучитьИмяВременногоФайла("db"));
	Иначе
		ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
		ИсточникДанных.Вставить("СтрокаСоединения", Строка(Новый УникальныйИдентификатор));
	КонецЕсли;
	СекцияData = Новый Соответствие();
	СекцияData.Вставить("ИсточникиДанных", ИсточникДанных);

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("otel", НастройкиОтел);
	ЗначенияДеталек.Вставить("data", СекцияData);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка;

КонецФункции
