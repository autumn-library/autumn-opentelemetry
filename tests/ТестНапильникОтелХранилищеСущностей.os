// НапильникХранилищеСущностей: спаны и гистограмма вызовов слоя репозиториев autumn-data.
//
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:MagicNumber-off
#Использовать autumn
#Использовать autumn-data
#Использовать asserts
#Использовать opentelemetry
#Использовать ".."
#Использовать "."

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&Тест
Процедура НапильникХранилища_ХранилищеИзAutumnData_Оборачивается() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Истина, Неопределено);
	Экспортер = Поделка.НайтиЖелудь("ЭкспортерСпановВПамяти");

	// Когда
	Хранилище = Поделка.НайтиЖелудь("ХранилищеСущностейФизическоеЛицо");
	Хранилище.Получить();

	// Тогда - бин обернут, вызов дал спан слоя репозитория поверх операции entity
	Ожидаем.Что(Строка(ТипЗнч(Хранилище))).Не_().Равно("ХранилищеСущностей");
	Спан = ЕдинственныйСпан(Экспортер, "ХранилищеСущностейФизическоеЛицо.Получить");
	Ожидаем.Что(Спан.ВидСпана()).Равно(ОтелВидСпана.Внутренний());
	Ожидаем.Что(Спан.Атрибуты().Получить("code.namespace")).Равно("ХранилищеСущностейФизическоеЛицо");
	Ожидаем.Что(Спан.Атрибуты().Получить("code.function.name")).Равно("Получить");

	Операция = ЕдинственныйСпан(Экспортер, "Получить ФизическоеЛицо");
	Ожидаем.Что(Операция.ИдРодительскогоСпана(), "Операция entity вложена в вызов репозитория").Равно(Спан.КонтекстСпана().ИдСпана());

КонецПроцедуры

&Тест
Процедура НапильникХранилища_ПользовательскоеХранилище_ОборачиваетМетодыЗапросаИУнаследованные() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Истина, Неопределено);
	Экспортер = Поделка.НайтиЖелудь("ЭкспортерСпановВПамяти");
	Хранилище = Поделка.НайтиЖелудь("ХранилищеФизическиеЛица");

	// Когда
	Лицо = Хранилище.СоздатьЭлемент();
	Лицо.Имя = "Пушкин";
	Хранилище.Сохранить(Лицо);
	Найденное = Хранилище.ПолучитьОдноПоИмяРавно("Пушкин");
	Хранилище.ПолучитьОбъектМодели();

	// Тогда
	Ожидаем.Что(Найденное.Имя).Равно("Пушкин");
	ЕдинственныйСпан(Экспортер, "ХранилищеФизическиеЛица.Сохранить");
	ЕдинственныйСпан(Экспортер, "ХранилищеФизическиеЛица.ПолучитьОдноПоИмяРавно");
	Ожидаем.Что(Экспортер.ПоИмени("ХранилищеФизическиеЛица.СоздатьЭлемент"), "Создание элемента в БД не ходит").ИмеетДлину(0);
	Ожидаем.Что(Экспортер.ПоИмени("ХранилищеФизическиеЛица.ПолучитьОбъектМодели"), "Геттеры не оборачиваются").ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура НапильникХранилища_ГистограммаВызововВСекундахСоСтатусом() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Истина, Неопределено);
	Метр = Поделка.НайтиЖелудь("ОтелМетр");
	Хранилище = Поделка.НайтиЖелудь("ХранилищеФизическиеЛица");

	// Когда - метод фикстуры спит 20 мс, два вызова дают сумму в сотые доли секунды
	Хранилище.Подождать();
	Хранилище.Подождать();
	Хранилище.Получить();

	// Тогда
	Данные = ДанныеМетрики(Метр, "entity.repository.invocations");
	Ожидаем.Что(Данные.ЕдиницаИзмерения()).Равно("s");
	Точка = ТочкаМетрики(Данные, "entity.repository", "ХранилищеФизическиеЛица");
	Ожидаем.Что(Атрибут(Точка, "code.function.name")).Равно("Подождать");
	Ожидаем.Что(Точка.Получить("count")).Равно(2);
	Ожидаем.Что(Точка.Получить("sum"), "Две задержки по 20 мс видны в секундах").БольшеИлиРавно(0.02);
	Ожидаем.Что(Точка.Получить("sum"), "Длительность в секундах, а не в миллисекундах").Меньше(1);
	Ожидаем.Что(Атрибут(Точка, "entity.repository.state")).Равно("success");
	Ожидаем.Что(Атрибут(Точка, "error.type")).Равно(Неопределено);
	// Пользовательское хранилище делегирует Получить родителю - хранилищу из autumn-data,
	// оно тоже обернуто, поэтому у делегированного метода по точке на каждый бин.
	Родитель = ТочкаМетрики(Данные, "entity.repository", "ХранилищеСущностейФизическоеЛицо");
	Ожидаем.Что(Атрибут(Родитель, "code.function.name")).Равно("Получить");
	Ожидаем.Что(Родитель.Получить("count")).Равно(1);

КонецПроцедуры

&Тест
Процедура НапильникХранилища_ОшибкаМетода_ПопадаетВСпанИГистограмму() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Истина, Неопределено);
	Экспортер = Поделка.НайтиЖелудь("ЭкспортерСпановВПамяти");
	Метр = Поделка.НайтиЖелудь("ОтелМетр");
	Хранилище = Поделка.НайтиЖелудь("ХранилищеФизическиеЛица");
	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить("Коннектор -> Коннектор.НетТакогоМетода()");

	// Когда
	Ожидаем.Что(Хранилище)
		.Метод("ВыполнитьСКоннектором", ПараметрыМетода)
		.ВыбрасываетИсключение("НетТакогоМетода");

	// Тогда
	Спан = ЕдинственныйСпан(Экспортер, "ХранилищеФизическиеЛица.ВыполнитьСКоннектором");
	Ожидаем.Что(Спан.КодСтатуса()).Равно(ОтелКодСтатуса.Ошибка());
	Ожидаем.Что(Спан.Атрибуты().Получить("error.type")).Не_().Равно(Неопределено);
	Ожидаем.Что(Спан.События()).ИмеетДлину(1);

	Точка = ТочкаМетрики(ДанныеМетрики(Метр, "entity.repository.invocations"), "code.function.name", "ВыполнитьСКоннектором");
	Ожидаем.Что(Атрибут(Точка, "entity.repository.state")).Равно("error");
	Ожидаем.Что(Атрибут(Точка, "error.type")).Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура НапильникХранилища_ПриВыключенномСлоеРепозитория_БинНеОборачивается() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Истина, Ложь);

	// Когда
	Хранилище = Поделка.НайтиЖелудь("ХранилищеСущностейФизическоеЛицо");

	// Тогда
	Ожидаем.Что(Строка(ТипЗнч(Хранилище))).Равно("ХранилищеСущностей");

КонецПроцедуры

&Тест
Процедура НапильникХранилища_ПриВыключенномОтел_БинНеОборачивается() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Неопределено, Неопределено);

	// Когда
	Хранилище = Поделка.НайтиЖелудь("ХранилищеСущностейФизическоеЛицо");

	// Тогда
	Ожидаем.Что(Строка(ТипЗнч(Хранилище))).Равно("ХранилищеСущностей");

КонецПроцедуры

// Служебные

Функция ПоделкаСДетальками(Знач ОтелВключен, Знач РепозиторийВключен)

	НастройкиРепозитория = Новый Соответствие();
	Если РепозиторийВключен <> Неопределено Тогда
		НастройкиРепозитория.Вставить("enabled", РепозиторийВключен);
	КонецЕсли;
	НастройкиEntity = Новый Соответствие();
	НастройкиEntity.Вставить("repository", НастройкиРепозитория);

	НастройкиОтел = Новый Соответствие();
	Если ОтелВключен <> Неопределено Тогда
		НастройкиОтел.Вставить("enabled", ОтелВключен);
	КонецЕсли;
	НастройкиОтел.Вставить("entity", НастройкиEntity);

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", Строка(Новый УникальныйИдентификатор));
	СекцияData = Новый Соответствие();
	СекцияData.Вставить("ИсточникиДанных", ИсточникДанных);

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("otel", НастройкиОтел);
	ЗначенияДеталек.Вставить("data", СекцияData);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка;

КонецФункции

Функция ЕдинственныйСпан(Знач Экспортер, Знач Имя)
	Спаны = Экспортер.ПоИмени(Имя);
	Ожидаем.Что(Спаны, "Ожидался один спан " + Имя + ", экспортированы: " + Экспортер.Имена()).ИмеетДлину(1);
	Возврат Спаны[0];
КонецФункции

Функция ДанныеМетрики(Знач Метр, Знач Имя)
	Для Каждого Инструмент Из Метр.Инструменты() Цикл
		Если Инструмент.Имя() = Имя Тогда
			Возврат Инструмент.Собрать(Метр.Ресурс(), Метр.ОбластьИнструментирования(), Инструмент.Имя(), Инструмент.Описание());
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Метрика не найдена: " + Имя;
КонецФункции

Функция ТочкаМетрики(Знач Данные, Знач КлючАтрибута, Знач ЗначениеАтрибута)
	Для Каждого Точка Из Данные.ТочкиДанных() Цикл
		Если Атрибут(Точка, КлючАтрибута) = ЗначениеАтрибута Тогда
			Возврат Точка;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение СтрШаблон("Точка с %1 = %2 не найдена", КлючАтрибута, ЗначениеАтрибута);
КонецФункции

// Атрибуты точки данных лежат в формате OTLP: массив пар key и value с типизированным полем.
Функция Атрибут(Знач Точка, Знач Ключ)
	Для Каждого Пара Из Точка.Получить("attributes") Цикл
		Если Пара.Получить("key") = Ключ Тогда
			Для Каждого Типизированное Из Пара.Получить("value") Цикл
				Возврат Типизированное.Значение;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции
