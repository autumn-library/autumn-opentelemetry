// НапильникОтелХранилищеСущностей: находит бины с прозвищем ХранилищеСущностей и отдает их
// инструментированию. Что обертка пишет в спаны и метрики, проверяет
// opentelemetry-instrumentation-entity; здесь - только выбор бинов и выключение настройками.
//
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать autumn
#Использовать asserts
#Использовать opentelemetry
#Использовать ".."
#Использовать "."

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&Тест
Процедура НапильникХранилища_БинСПрозвищем_Оборачивается() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Истина, Неопределено);
	Экспортер = Поделка.НайтиЖелудь("ЭкспортерСпановВПамяти");

	// Когда
	Хранилище = Поделка.НайтиЖелудь("ХранилищеПодопытное");
	Результат = Хранилище.Получить();

	// Тогда - бин подменен оберткой, вызов метода дал спан слоя хранилищ
	Ожидаем.Что(Строка(ТипЗнч(Хранилище))).Не_().Равно("ХранилищеЗаглушка");
	Ожидаем.Что(Результат, "Обертка возвращает результат метода").Равно("получено");

	Спаны = Экспортер.ПоИмени("ХранилищеПодопытное.Получить");
	Ожидаем.Что(Спаны, "Ожидался спан вызова хранилища").ИмеетДлину(1);
	Ожидаем.Что(Спаны[0].ВидСпана()).Равно(ОтелВидСпана.Внутренний());

КонецПроцедуры

&Тест
Процедура НапильникХранилища_БинБезПрозвища_НеОборачивается() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Истина, Неопределено);

	// Когда
	Хранилище = Поделка.НайтиЖелудь("ХранилищеБезПрозвища");

	// Тогда
	Ожидаем.Что(Строка(ТипЗнч(Хранилище))).Равно("ХранилищеЗаглушка");

КонецПроцедуры

&Тест
Процедура НапильникХранилища_ПриВыключенномСлоеХранилищ_БинНеОборачивается() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Истина, Ложь);

	// Когда
	Хранилище = Поделка.НайтиЖелудь("ХранилищеПодопытное");

	// Тогда
	Ожидаем.Что(Строка(ТипЗнч(Хранилище))).Равно("ХранилищеЗаглушка");

КонецПроцедуры

&Тест
Процедура НапильникХранилища_ПриВыключенномОтел_БинНеОборачивается() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Неопределено, Неопределено);

	// Когда
	Хранилище = Поделка.НайтиЖелудь("ХранилищеПодопытное");

	// Тогда
	Ожидаем.Что(Строка(ТипЗнч(Хранилище))).Равно("ХранилищеЗаглушка");

КонецПроцедуры

// Служебные

Функция ПоделкаСДетальками(Знач ОтелВключен, Знач СлойВключен)

	НастройкиСлоя = Новый Соответствие();
	Если СлойВключен <> Неопределено Тогда
		НастройкиСлоя.Вставить("enabled", СлойВключен);
	КонецЕсли;
	НастройкиEntity = Новый Соответствие();
	НастройкиEntity.Вставить("repository", НастройкиСлоя);

	НастройкиОтел = Новый Соответствие();
	Если ОтелВключен <> Неопределено Тогда
		НастройкиОтел.Вставить("enabled", ОтелВключен);
	КонецЕсли;
	НастройкиОтел.Вставить("entity", НастройкиEntity);

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("otel", НастройкиОтел);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка;

КонецФункции
