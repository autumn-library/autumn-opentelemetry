// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать autumn
#Использовать asserts
#Использовать opentelemetry
#Использовать ".."
#Использовать "."

Перем Поделка;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт
	НастройкиОтел = Новый Соответствие();
	НастройкиОтел.Вставить("enabled", Истина);
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("otel", НастройкиОтел);
	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();
КонецПроцедуры

&Тест
Процедура НапильникЗамеряемый_МетодВыполняетсяБезОшибок() Экспорт

	// Когда
	Служба = Поделка.НайтиЖелудь("ЗамеряемаяСлужба");
	Результат = Служба.ВыполнитьДолгуюОперацию();

	// Тогда - метод завершился без ошибок, длительность записана в гистограмму
	Ожидаем.Что(Результат).Равно("готово");

КонецПроцедуры

&Тест
Процедура НапильникЗамеряемый_МетодВызываетсяНесколькоРаз() Экспорт

	// Дано
	Служба = Поделка.НайтиЖелудь("ЗамеряемаяСлужба");

	// Когда - несколько вызовов подряд
	Служба.ВыполнитьДолгуюОперацию();
	Служба.ВыполнитьДолгуюОперацию();
	Служба.ВыполнитьДолгуюОперацию();

	// Тогда - все вызовы завершились без ошибок
	Ожидаем.Что(Истина).Равно(Истина);

КонецПроцедуры

&Тест
Процедура НапильникЗамеряемый_МетодУровняМетода_ВыполняетсяБезОшибок() Экспорт

	// Когда
	Служба = Поделка.НайтиЖелудь("ЗамеряемаяСлужбаМетод");
	Результат = Служба.ЗамеряемыйМетод();

	// Тогда
	Ожидаем.Что(Результат).Равно("замерено");

КонецПроцедуры

&Тест
Процедура НапильникЗамеряемый_МетодСЯвнымИменемМетрики_ВыполняетсяБезОшибок() Экспорт

	// Когда
	Служба = Поделка.НайтиЖелудь("ЗамеряемаяСлужбаМетод");
	Результат = Служба.МетодСЯвнымИменем();

	// Тогда
	Ожидаем.Что(Результат).Равно("явное-имя");

КонецПроцедуры

&Тест
Процедура НапильникЗамеряемый_ПриОтелОтключен_МетодВыполняетсяБезОборачивания() Экспорт

// Дано - otel.enabled не задан (по умолчанию Ложь)
ПустойСовет = Новый СоветДругогоМастера();
ПоделкаБезОтел = Новый Поделка(ПустойСовет);
ПоделкаБезОтел.ЗапуститьПриложение();

// Когда
Служба = ПоделкаБезОтел.НайтиЖелудь("ЗамеряемаяСлужба");
Результат = Служба.ВыполнитьДолгуюОперацию();

// Тогда - метод работает, бин не обёрнут декоратором → SDK не инициализировался
Ожидаем.Что(Результат).Равно("готово");
Ожидаем.Что(Строка(ТипЗнч(Служба))).Равно("ЗамеряемаяСлужба");

КонецПроцедуры

&Тест
Процедура НапильникЗамеряемый_ПриСтроковойДетальке_БинОборачивается() Экспорт

	// Дано - otel.enabled задан строкой "true": провайдер переменных среды в configor
	// отдаёт значения как есть, без приведения к булеву
	ПоделкаСоСтрокой = ПоделкаСДеталькойOtelEnabled("true");

	// Когда
	Служба = ПоделкаСоСтрокой.НайтиЖелудь("ЗамеряемаяСлужба");
	Результат = Служба.ВыполнитьДолгуюОперацию();

	// Тогда - бин обёрнут декоратором, инструментирование включено
	Ожидаем.Что(Результат).Равно("готово");
	Ожидаем.Что(Строка(ТипЗнч(Служба))).Не_().Равно("ЗамеряемаяСлужба");

КонецПроцедуры

&Тест
Процедура НапильникЗамеряемый_ПриНеРаспознаннойСтроковойДетальке_БинНеОборачивается() Экспорт

	// Дано - значение, которое OneScript не умеет неявно привести к булеву.
	// По спецификации OTel включает только явное "true", всё остальное - выключено,
	// а не ошибка "Преобразование к типу 'Булево' не поддерживается" при старте
	ПоделкаСЕдиницей = ПоделкаСДеталькойOtelEnabled("1");

	// Когда
	Служба = ПоделкаСЕдиницей.НайтиЖелудь("ЗамеряемаяСлужба");
	Результат = Служба.ВыполнитьДолгуюОперацию();

	// Тогда - приложение поднялось, бин не обёрнут декоратором
	Ожидаем.Что(Результат).Равно("готово");
	Ожидаем.Что(Строка(ТипЗнч(Служба))).Равно("ЗамеряемаяСлужба");

КонецПроцедуры

&Тест
Процедура НапильникЗамеряемый_ДлительностьПишетсяВСекундах() Экспорт

	// Дано
	Служба = Поделка.НайтиЖелудь("ЗамеряемаяСлужбаМетод");
	Метр = Поделка.НайтиЖелудь("ОтелМетр");

	// Когда
	Служба.МетодСЯвнымИменем();

	// Тогда - единица гистограммы seconds по semconv. Метод спит 20 мс: в секундах это
	// сотые доли, а регрессия до миллисекунд дала бы значение больше 1.
	Данные = Неопределено;
	Для Каждого Инструмент Из Метр.Инструменты() Цикл
		Если Инструмент.Имя() = "custom.timer" Тогда
			Данные = Инструмент.Собрать(
				Метр.Ресурс(), Метр.ОбластьИнструментирования(), Инструмент.Имя(), Инструмент.Описание());
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Данные, "Гистограмма custom.timer зарегистрирована").Не_().Равно(Неопределено);
	Ожидаем.Что(Данные.ЕдиницаИзмерения()).Равно("s");

	ЗадержкаВСекундах = 0.01;
	// Порог заведомо ниже 20 - значения в миллисекундах - и заведомо выше любой паузы
	// планировщика на загруженной машине сборки, чтобы проверка не мигала.
	ПорогМиллисекунд = 10;
	Максимум = Данные.ТочкиДанных()[0].Получить("max");
	Ожидаем.Что(Максимум, "Задержка 20 мс видна в секундах").БольшеИлиРавно(ЗадержкаВСекундах);
	Ожидаем.Что(Максимум, "Длительность в секундах, а не в миллисекундах").Меньше(ПорогМиллисекунд);

КонецПроцедуры

// Создаёт поделку с деталькой otel.enabled, равной переданному значению.
Функция ПоделкаСДеталькойOtelEnabled(Знач ЗначениеДетальки)

	НастройкиОтел = Новый Соответствие();
	НастройкиОтел.Вставить("enabled", ЗначениеДетальки);
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("otel", НастройкиОтел);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);

	НоваяПоделка = Новый Поделка(Совет);
	НоваяПоделка.ЗапуститьПриложение();

	Возврат НоваяПоделка;

КонецФункции
