// Завязь ОтелАппендерLogos в ОтелДуб: аппендер logos, перенаправляющий логи в OTel Logs API.
// Как аппендер переводит события logos в записи логов, проверяет opentelemetry;
// здесь - создание желудя и выключение деталькой otel.enabled.
//
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать autumn
#Использовать asserts
#Использовать opentelemetry
#Использовать ".."
#Использовать "."

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&Тест
Процедура ЗавязьАппендера_ПриВключенномОтел_ОтдаетАппендерСЛоггером() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Истина);

	// Когда
	Аппендер = Поделка.НайтиЖелудь("ОтелАппендерLogos");

	// Тогда
	Ожидаем.Что(Аппендер).ИмеетТип("ОтелАппендерLogos");
	Ожидаем.Что(Аппендер.Логгер()).Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЗавязьАппендера_ПриСтроковойДетальке_Включается() Экспорт

	// Дано - переменные среды отдают строки
	Поделка = ПоделкаСДетальками("true");

	// Когда
	Аппендер = Поделка.НайтиЖелудь("ОтелАппендерLogos");

	// Тогда
	Ожидаем.Что(Аппендер.Логгер()).Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЗавязьАппендера_ПриВыключенномОтел_ОтдаетАппендерБезЛоггера() Экспорт

	// Дано - otel.enabled = false
	Поделка = ПоделкаСДетальками(Ложь);

	// Когда
	Аппендер = Поделка.НайтиЖелудь("ОтелАппендерLogos");

	// Тогда - аппендер есть, чтобы конфигурация logos с ним не ломалась, но ничего не пишет
	Ожидаем.Что(Аппендер).ИмеетТип("ОтелАппендерLogos");
	Ожидаем.Что(Аппендер.Логгер()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЗавязьАппендера_ПриНезаданномОтел_ОтдаетАппендерБезЛоггера() Экспорт

	// Дано - otel.enabled не задан
	Поделка = ПоделкаСДетальками(Неопределено);

	// Когда-Тогда
	Ожидаем.Что(Поделка.НайтиЖелудь("ОтелАппендерLogos").Логгер()).Равно(Неопределено);

КонецПроцедуры

// Служебные

Функция ПоделкаСДетальками(Знач ОтелВключен)

	НастройкиОтел = Новый Соответствие();
	Если ОтелВключен <> Неопределено Тогда
		НастройкиОтел.Вставить("enabled", ОтелВключен);
	КонецЕсли;

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("otel", НастройкиОтел);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка;

КонецФункции
