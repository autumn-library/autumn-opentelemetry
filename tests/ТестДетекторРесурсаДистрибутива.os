// Ресурс SDK: детектор дистрибутива autumn-opentelemetry и детекторы приложения - желуди
// с прозвищем ДетекторРесурса.
//
// ТестовыйОтелДуб подменяет завязь ОтелSdk, поэтому ресурс настоящей завязи проверяется
// прямым вызовом ОтелДуб.ОтелSdk с выключенными экспортерами.
//
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать autumn
#Использовать asserts
#Использовать extends
#Использовать opentelemetry
#Использовать ".."
#Использовать "."

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&Тест
Процедура Детектор_Обнаружить_ОтдаетИмяИВерсиюДистрибутива() Экспорт

	// Когда
	Ресурс = Новый ОтелДетекторРесурсаДистрибутива().Обнаружить();

	// Тогда - версия та же, что в packagedef библиотеки
	КаталогБиблиотеки = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
	Ожидаем.Что(Ресурс.Атрибуты().Получить("telemetry.distro.name")).Равно("autumn-opentelemetry");
	Ожидаем.Что(Ресурс.Атрибуты().Получить("telemetry.distro.version")).Равно(ОтелУтилиты.ВерсияПакета(КаталогБиблиотеки));
	Ожидаем.Что(Ресурс.Атрибуты().Получить("telemetry.distro.version")).Не_().Равно("unknown");
	Ожидаем.Что(Ресурс.АдресСхемы()).Равно("https://opentelemetry.io/schemas/1.44.0");

КонецПроцедуры

&Тест
Процедура Детектор_РеализуетИнтерфейсДетектораРесурса() Экспорт

	// Когда-Тогда - без &Реализует ядро не примет детектор
	Валидатор = Новый ВалидаторРеализации();
	Ожидаем.Что(Валидатор.РеализуетИнтерфейс(Новый ОтелДетекторРесурсаДистрибутива(), "ИнтерфейсДетекторРесурса"))
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДетекторыРесурса_ПоПрозвищу_ДистрибутивИДетекторыПриложенияПоПорядку() Экспорт

	// Дано
	Поделка = ПоделкаСДетальками(Новый Соответствие());

	// Когда
	Детекторы = Поделка.НайтиЖелуди("ДетекторРесурса");

	// Тогда - порядок по возрастанию &Порядок
	Ожидаем.Что(Детекторы).ИмеетДлину(3);
	Ожидаем.Что(Детекторы[0]).ИмеетТип("ОтелДетекторРесурсаДистрибутива");
	Ожидаем.Что(Детекторы[1]).ИмеетТип("ДетекторРесурсаПриложения");
	Ожидаем.Что(Детекторы[2]).ИмеетТип("ВажныйДетекторРесурсаПриложения");

КонецПроцедуры

&Тест
Процедура ОтелSdk_Ресурс_СодержитДистрибутивИДетекторыПриложения() Экспорт

	// Дано
	НастройкиОтел = НастройкиБезЭкспорта();
	Поделка = ПоделкаСДетальками(НастройкиОтел);

	// Когда
	Атрибуты = АтрибутыРесурсаSdk(Поделка);

	// Тогда - детектор с большим &Порядок важнее
	Ожидаем.Что(Атрибуты.Получить("telemetry.distro.name")).Равно("autumn-opentelemetry");
	Ожидаем.Что(Атрибуты.Получить("app.detector")).Равно("важный");
	Ожидаем.Что(Атрибуты.Получить("app.overridden")).Равно("детектор");

КонецПроцедуры

&Тест
Процедура ОтелSdk_АтрибутыРесурсаИзКонфигурации_ВажнееДетекторов() Экспорт

	// Дано
	НастройкиОтел = НастройкиБезЭкспорта();
	НастройкиРесурса = Новый Соответствие();
	НастройкиРесурса.Вставить("attributes", "app.overridden=конфигурация");
	НастройкиОтел.Вставить("resource", НастройкиРесурса);
	Поделка = ПоделкаСДетальками(НастройкиОтел);

	// Когда
	Атрибуты = АтрибутыРесурсаSdk(Поделка);

	// Тогда
	Ожидаем.Что(Атрибуты.Получить("app.overridden")).Равно("конфигурация");

КонецПроцедуры

// Служебные

Функция НастройкиБезЭкспорта()

	НастройкиОтел = Новый Соответствие();
	Для Каждого Сигнал Из СтрРазделить("traces,metrics,logs", ",") Цикл
		НастройкиСигнала = Новый Соответствие();
		НастройкиСигнала.Вставить("exporter", "none");
		НастройкиОтел.Вставить(Сигнал, НастройкиСигнала);
	КонецЦикла;

	Возврат НастройкиОтел;

КонецФункции

Функция АтрибутыРесурсаSdk(Знач Поделка)

	Sdk = Новый ОтелДуб().ОтелSdk(Поделка);
	Попытка
		Атрибуты = Sdk.ПровайдерТрассировки().Ресурс().Атрибуты();
	Исключение
		ОтелГлобальный.СброситьИЗакрыть();
		ВызватьИсключение;
	КонецПопытки;
	ОтелГлобальный.СброситьИЗакрыть();

	Возврат Атрибуты;

КонецФункции

Функция ПоделкаСДетальками(Знач НастройкиОтел)

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("otel", НастройкиОтел);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(ЗначенияДеталек);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка;

КонецФункции
